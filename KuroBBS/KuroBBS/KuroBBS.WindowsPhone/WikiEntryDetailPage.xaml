<Page
    x:Name="WikiDetailRoot"
    x:Class="KuroBBS.WikiEntryDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:KuroBBS.Helpers"
    xmlns:models="using:KuroBBS.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.BottomAppBar>
        <CommandBar Background="#121216" ClosedDisplayMode="Minimal" IsOpen="False">
            <AppBarButton Icon="Back" Label="返回" Click="OnBackClick" />
            <AppBarButton Icon="Refresh" Label="刷新" Click="OnRefreshClick" />
        </CommandBar>
    </Page.BottomAppBar>

    <Grid>
        <!-- Native Progress Indicator -->
        <ProgressBar VerticalAlignment="Top" IsIndeterminate="{Binding IsBusy}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                     Foreground="{StaticResource MetroAccentBrush}" Canvas.ZIndex="99" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,0,16,24">
                
                <!-- Metro Page Title Area -->
                <StackPanel Margin="0,14,0,12">
                    <TextBlock Text="KURO WIKI · 条目详情" FontSize="11" Foreground="{StaticResource MetroAccentBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Light" Foreground="White" Margin="0,2,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding OrgFullName}" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,2,0,0"
                               Visibility="{Binding OrgFullName, Converter={StaticResource NullToVis}}" />
                </StackPanel>

                <!-- Entry Meta Info (Editor, Update Time, Views) -->
                <Border Background="#1A1A22" BorderBrush="#2C2C36" BorderThickness="1" Padding="10,8" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding LastEditUserName, Converter={StaticResource StringFormatConverter}, ConverterParameter='最后编辑: {0}'}"
                                       FontSize="11" Foreground="{StaticResource MetroSubTextBrush}"
                                       Visibility="{Binding LastEditUserName, Converter={StaticResource NullToVis}}" />
                            <TextBlock Text="{Binding LastUpdateTime, Converter={StaticResource StringFormatConverter}, ConverterParameter='更新时间: {0}'}"
                                       FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,2,0,0"
                                       Visibility="{Binding LastUpdateTime, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding BrowseCountText}" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Cover Image (if available) -->
                <Border Background="#141418" Margin="0,0,0,16" Visibility="{Binding HasCoverImage, Converter={StaticResource BoolToVis}}">
                    <Image Source="{Binding CoverImageUrl, Converter={StaticResource ImageCache}}" Stretch="Uniform" MaxHeight="220" />
                </Border>

                <!-- Detail Modules -->
                <ItemsControl ItemsSource="{Binding Modules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <!-- Module Header -->
                                <Border Background="#20202A" BorderBrush="#353545" BorderThickness="0,0,0,1" Padding="8,6" Margin="0,0,0,8"
                                        Visibility="{Binding Title, Converter={StaticResource NullToVis}}">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource MetroAccentBrush}" />
                                </Border>

                                <!-- Module Components -->
                                <ItemsControl ItemsSource="{Binding Components}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">
                                                
                                                <!-- 1. ROLE COMPONENT (Character Card) -->
                                                <StackPanel Visibility="{Binding HasRoleInfo, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                                    <Border Background="#161620" BorderBrush="#2C2C3E" BorderThickness="1" Padding="12">
                                                        <StackPanel>
                                                            <!-- Header: Figure/Avatar + Title + Class/Type Badge -->
                                                            <Grid Margin="0,0,0,10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Avatar thumbnail -->
                                                                <Border Grid.Column="0" Width="64" Height="64" Background="#20202E" BorderBrush="#3C3C50" BorderThickness="1" Margin="0,0,12,0"
                                                                        Visibility="{Binding RoleInfo.RoleAvatar, Converter={StaticResource NullToVis}}">
                                                                    <Image Source="{Binding RoleInfo.RoleAvatar, Converter={StaticResource ImageCache}}" Stretch="UniformToFill" />
                                                                </Border>

                                                                <!-- Title, Subtitle, Quality -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding RoleInfo.Title}" FontSize="18" FontWeight="Bold" Foreground="White" />
                                                                        
                                                                        <!-- Quality text badge (e.g. S) -->
                                                                        <Border Background="#FFD700" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                                Visibility="{Binding RoleInfo.HasQualityText, Converter={StaticResource BoolToVis}}">
                                                                            <TextBlock Text="{Binding RoleInfo.RoleInitQuality}" FontSize="11" FontWeight="Bold" Foreground="Black" />
                                                                        </Border>

                                                                        <!-- Quality image badge (e.g. golden icon) -->
                                                                        <Border Width="24" Height="24" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                                Visibility="{Binding RoleInfo.HasQualityImage, Converter={StaticResource BoolToVis}}">
                                                                            <Image Source="{Binding RoleInfo.RoleInitQuality, Converter={StaticResource ImageCache}}" Stretch="Uniform" />
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding RoleInfo.Subtitle}" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,2,0,0"
                                                                               Visibility="{Binding RoleInfo.Subtitle, Converter={StaticResource NullToVis}}" />
                                                                    
                                                                    <!-- Robot Type with optional Icon -->
                                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding RoleInfo.RobotType, Converter={StaticResource NullToVis}}">
                                                                        <Border Background="#007ACC" Padding="6,2" VerticalAlignment="Center">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Border Width="14" Height="14" Margin="0,0,4,0" Visibility="{Binding RoleInfo.RobotTypeImage, Converter={StaticResource NullToVis}}">
                                                                                    <Image Source="{Binding RoleInfo.RobotTypeImage, Converter={StaticResource ImageCache}}" Stretch="Uniform" />
                                                                                </Border>
                                                                                <TextBlock Text="{Binding RoleInfo.RobotType}" FontSize="10" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <!-- Camp/Faction Icon -->
                                                                <Border Grid.Column="2" Width="40" Height="40" Margin="6,0,0,0" VerticalAlignment="Top"
                                                                        Visibility="{Binding RoleInfo.CampIcon, Converter={StaticResource NullToVis}}">
                                                                    <Image Source="{Binding RoleInfo.CampIcon, Converter={StaticResource ImageCache}}" Stretch="Uniform" />
                                                                </Border>
                                                            </Grid>

                                                            <!-- Full Portrait Illustration (if available) -->
                                                            <Border Background="#101018" Margin="0,0,0,10" Visibility="{Binding RoleInfo.RoleFigure, Converter={StaticResource NullToVis}}">
                                                                <Image Source="{Binding RoleInfo.RoleFigure, Converter={StaticResource ImageCache}}" Stretch="Uniform" MaxHeight="300" />
                                                            </Border>

                                                            <!-- Quote / Signature line -->
                                                            <Border Background="#1C1C28" BorderBrush="{StaticResource MetroAccentBrush}" BorderThickness="3,0,0,0" Padding="10,6" Margin="0,0,0,10"
                                                                    Visibility="{Binding RoleInfo.RoleQuotes, Converter={StaticResource NullToVis}}">
                                                                <TextBlock Text="{Binding RoleInfo.RoleQuotes}" FontSize="12" FontStyle="Italic" Foreground="#D0E8FF" TextWrapping="Wrap" />
                                                            </Border>

                                                             <!-- Intro description -->
                                                            <Border Background="#181824" BorderBrush="#2A2A3C" BorderThickness="1" Padding="10,8" Margin="0,0,0,10"
                                                                    Visibility="{Binding RoleInfo.HasRoleIntroduce, Converter={StaticResource BoolToVis}}">
                                                                <StackPanel>
                                                                    <TextBlock Text="机体简介" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MetroAccentBrush}" Margin="0,0,0,4" />
                                                                    <TextBlock Text="{Binding RoleInfo.RoleIntroduce}" FontSize="12" Foreground="#D0D0E0" TextWrapping="Wrap" LineHeight="18" />
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Energy & Features tags -->
                                                            <StackPanel Visibility="{Binding RoleInfo.HasEnergy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                                                <ItemsControl ItemsSource="{Binding RoleInfo.EnergyList}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="#242436" BorderBrush="#3A3A52" BorderThickness="1" Padding="8,3" Margin="0,0,6,6">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="{Binding Key}" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,0,4,0" />
                                                                                    <TextBlock Text="{Binding Value}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>

                                                            <ItemsControl ItemsSource="{Binding RoleInfo.FeatureList}" Visibility="{Binding RoleInfo.HasFeatures, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="#1E1E2C" Padding="8,4" Margin="0,0,0,4">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <Border Background="#007ACC" Padding="4,1" Margin="0,0,8,0" VerticalAlignment="Top">
                                                                                    <TextBlock Text="{Binding Key}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                                                                </Border>
                                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" Foreground="#C8C8D8" TextWrapping="Wrap" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Effect Card -->
                                                            <Border Background="#1E1E2C" Padding="8,6" Margin="0,0,0,8" Visibility="{Binding RoleInfo.HasEffect, Converter={StaticResource BoolToVis}}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Width="36" Height="36" Background="#14141E" Margin="0,0,8,0" Visibility="{Binding RoleInfo.EffectIcon, Converter={StaticResource NullToVis}}">
                                                                        <Image Source="{Binding RoleInfo.EffectIcon, Converter={StaticResource ImageCache}}" Stretch="Uniform" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1" Text="{Binding RoleInfo.EffectDescription}" FontSize="11" Foreground="#C8C8D8" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>

                                                            <!-- Stats (HP, ATK, DEF, CRIT) -->
                                                            <Border Background="#12121A" BorderBrush="#282836" BorderThickness="1" Padding="6,8" Margin="0,0,0,10"
                                                                    Visibility="{Binding RoleInfo.HasStats, Converter={StaticResource BoolToVis}}">
                                                                <ItemsControl ItemsSource="{Binding RoleInfo.Stats}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border MinWidth="68" Margin="0,0,8,0">
                                                                                <StackPanel HorizontalAlignment="Center">
                                                                                    <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Center" />
                                                                                    <TextBlock Text="{Binding DisplayValue}" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>

                                                            <!-- Profile List (Height, Weight, Age, LaunchDay, etc.) -->
                                                            <Border Background="#181824" BorderBrush="#2A2A3C" BorderThickness="1" Padding="10,8" Margin="0,0,0,10"
                                                                    Visibility="{Binding RoleInfo.HasProfiles, Converter={StaticResource BoolToVis}}">
                                                                <StackPanel>
                                                                    <TextBlock Text="机体档案 / 基础资料" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MetroAccentBrush}" Margin="0,0,0,6" />
                                                                    <ItemsControl ItemsSource="{Binding RoleInfo.ProfileList}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Grid Margin="0,3">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="76" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Text="{Binding Key}" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" />
                                                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" FontWeight="SemiBold" Foreground="#E0E0E8" TextWrapping="Wrap" />
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Gears / Weapons / Gifts List -->
                                                            <StackPanel Visibility="{Binding RoleInfo.HasGears, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                                                <TextBlock Text="关联装备 / 专属武器" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MetroAccentBrush}" Margin="0,0,0,6" />
                                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                                    <ItemsControl ItemsSource="{Binding RoleInfo.GearList}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Button Background="#20202E" BorderBrush="#35354A" BorderThickness="1" Padding="8,6" Margin="0,0,8,0"
                                                                                        Click="OnGearItemClick">
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <Border Width="32" Height="32" Background="#14141E" Margin="0,0,8,0"
                                                                                                Visibility="{Binding ImgUrl, Converter={StaticResource NullToVis}}">
                                                                                            <Image Source="{Binding ImgUrl, Converter={StaticResource ImageCache}}" Stretch="Uniform" />
                                                                                        </Border>
                                                                                        <StackPanel VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding Title}" FontSize="10" Foreground="{StaticResource MetroSubTextBrush}" />
                                                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                                                        </StackPanel>
                                                                                    </StackPanel>
                                                                                </Button>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </ScrollViewer>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!-- 1.5 CONSCIOUSNESS COMPONENT (意识手册: 简介 / 意识立绘 / 突破素材 / 意识故事 / 使用心得) -->
                                                <StackPanel Visibility="{Binding HasConsciousnessInfo, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                                                    <StackPanel.Resources>
                                                        <!-- Stat cell (生命/攻击/会心/防御) -->
                                                        <DataTemplate x:Key="ConsciousnessStatCell">
                                                            <Border Background="#1A1A26" BorderBrush="#2C2C3E" BorderThickness="1" Padding="8,6" Margin="0,0,6,6">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Width="22" Height="22" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                                                                        <Image Source="{Binding IconUrl, Converter={StaticResource ImageCache}, ConverterParameter=90}" Stretch="Uniform" />
                                                                    </Border>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{StaticResource MetroSubTextBrush}" />
                                                                        <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </StackPanel.Resources>

                                                    <!-- Component header -->
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MetroAccentBrush}" Margin="0,0,0,6"
                                                               Visibility="{Binding Title, Converter={StaticResource NullToVis}}" />

                                                    <!-- ===== 简介 (Intro: rarity / level cap / traits / stats / set effects) ===== -->
                                                    <StackPanel Visibility="{Binding Consciousness.HasRarity, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                                        <Border Background="#141420" BorderBrush="#2A2A3C" BorderThickness="1" Padding="12">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Left: rarity + meta -->
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Consciousness.Rarity}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource MetroGoldBrush}" />
                                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                        <TextBlock Text="{Binding Consciousness.LevelCap, Converter={StaticResource StringFormatConverter}, ConverterParameter='等级上限 {0}'}"
                                                                                   FontSize="11" Foreground="#D0D0DC" Margin="0,0,10,0"
                                                                                   Visibility="{Binding Consciousness.LevelCap, Converter={StaticResource NullToVis}}" />
                                                                        <TextBlock Text="{Binding Consciousness.ApplicableTo, Converter={StaticResource StringFormatConverter}, ConverterParameter='适用 {0}'}"
                                                                                   FontSize="11" Foreground="#D0D0DC"
                                                                                   Visibility="{Binding Consciousness.ApplicableTo, Converter={StaticResource NullToVis}}" />
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <!-- Right: cover illustration -->
                                                                <Border Grid.Column="1" Width="72" Height="72" Background="#101016" BorderBrush="#38384C" BorderThickness="1"
                                                                        Visibility="{Binding Consciousness.HasCoverImage, Converter={StaticResource BoolToVis}}">
                                                                    <Image Source="{Binding Consciousness.CoverImageUrl, Converter={StaticResource ImageCache}, ConverterParameter=160}" Stretch="UniformToFill" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Trait / Acquire chips -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                            <Border Background="#25304A" Padding="8,3" Margin="0,0,6,0"
                                                                    Visibility="{Binding Consciousness.Traits, Converter={StaticResource NullToVis}}">
                                                                <TextBlock Text="{Binding Consciousness.Traits}" FontSize="11" FontWeight="SemiBold" Foreground="#4FC3F7" />
                                                            </Border>
                                                            <Border Background="#252538" Padding="8,3"
                                                                    Visibility="{Binding Consciousness.Acquire, Converter={StaticResource NullToVis}}">
                                                                <TextBlock Text="{Binding Consciousness.Acquire}" FontSize="11" Foreground="#C8C8D8" TextWrapping="Wrap" />
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- ===== 属性（初始/最大）1/2/3位 与 4/5/6位 ===== -->
                                                    <StackPanel Visibility="{Binding Consciousness.HasStats, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                                        <TextBlock Text="属性（初始 / 最大）" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,0,0,6" />

                                                        <!-- 1/2/3 号位 -->
                                                        <StackPanel Visibility="{Binding Consciousness.HasPrimaryStats, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                                            <TextBlock Text="1 / 2 / 3 号位" FontSize="10" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,0,0,4" />
                                                            <ItemsControl ItemsSource="{Binding Consciousness.PrimaryStats}" ItemTemplate="{StaticResource ConsciousnessStatCell}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </StackPanel>

                                                        <!-- 4/5/6 号位 -->
                                                        <StackPanel Visibility="{Binding Consciousness.HasSecondaryStats, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="4 / 5 / 6 号位" FontSize="10" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,0,0,4" />
                                                            <ItemsControl ItemsSource="{Binding Consciousness.SecondaryStats}" ItemTemplate="{StaticResource ConsciousnessStatCell}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- ===== 套装技能效果 ===== -->
                                                    <StackPanel Visibility="{Binding Consciousness.HasSetEffects, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                                        <TextBlock Text="套装技能效果" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,0,0,6" />
                                                        <ItemsControl ItemsSource="{Binding Consciousness.SetEffects}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="#1A1A26" BorderBrush="#2C2C3E" BorderThickness="1" Padding="10,8" Margin="0,0,0,6">
                                                                        <StackPanel>
                                                                            <Border Background="#FF8C00" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,5"
                                                                                    Visibility="{Binding HasTitle, Converter={StaticResource BoolToVis}}">
                                                                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                                                            </Border>
                                                                            <TextBlock Text="{Binding Body}" FontSize="12" Foreground="#D0D0DC" LineHeight="18" TextWrapping="Wrap"
                                                                                       Visibility="{Binding HasBody, Converter={StaticResource BoolToVis}}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <!-- ===== 意识立绘 (illustration tabs + big art) ===== -->
                                                    <StackPanel Visibility="{Binding Consciousness.HasIllustrations, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                                        <TextBlock Text="意识立绘" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,0,0,6" />
                                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                                                            <ItemsControl ItemsSource="{Binding Consciousness.Illustrations}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Background="{Binding IsSelected, Converter={StaticResource BoolToAccentConverter}}"
                                                                                Foreground="{Binding IsSelected, Converter={StaticResource BoolToTextBrushConverter}}"
                                                                                BorderThickness="0" Padding="8,4" Margin="0,0,6,0" Click="OnConsciousnessIllustrationClick">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Border Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                                        Visibility="{Binding TabIconUrl, Converter={StaticResource NullToVis}}">
                                                                                    <Image Source="{Binding TabIconUrl, Converter={StaticResource ImageCache}, ConverterParameter=80}" Stretch="Uniform" />
                                                                                </Border>
                                                                                <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>

                                                        <Border Background="#101016" BorderBrush="#282836" BorderThickness="1" Padding="6"
                                                                Visibility="{Binding Consciousness.HasActiveIllustrationImage, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel>
                                                                <Image helpers:KuroGifHelper.GifSource="{Binding Consciousness.ActiveIllustrationImage}"
                                                                       Source="{Binding Consciousness.ActiveIllustrationImage, Converter={StaticResource ImageCache}, ConverterParameter=720}"
                                                                       Stretch="Uniform" MaxHeight="360" />
                                                                <TextBlock Text="{Binding Consciousness.ActiveIllustrationPainter, Converter={StaticResource StringFormatConverter}, ConverterParameter='画师: {0}'}"
                                                                           FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,6,0,0" HorizontalAlignment="Right"
                                                                           Visibility="{Binding Consciousness.HasActiveIllustrationPainter, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- ===== 突破素材 ===== -->
                                                    <StackPanel Visibility="{Binding Consciousness.HasBreakStages, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                                        <TextBlock Text="突破素材" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,0,0,6" />
                                                        <ItemsControl ItemsSource="{Binding Consciousness.BreakStages}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="#161622" BorderBrush="#2A2A3C" BorderThickness="1" Padding="10,8" Margin="0,0,0,6">
                                                                        <StackPanel>
                                                                            <Border Background="#007ACC" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,6">
                                                                                <TextBlock Text="{Binding Stage}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                                                            </Border>
                                                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                                                <ItemsControl ItemsSource="{Binding Materials}">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <StackPanel Orientation="Horizontal" />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Border Background="#1A1A26" BorderBrush="#2C2C3E" BorderThickness="1" Padding="6" Margin="0,0,6,0">
                                                                                                <StackPanel Width="64" HorizontalAlignment="Center">
                                                                                                    <Border Width="44" Height="44" Background="#121218" BorderBrush="#38384C" BorderThickness="1" HorizontalAlignment="Center"
                                                                                                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                                                                                                        <Image Source="{Binding IconUrl, Converter={StaticResource ImageCache}, ConverterParameter=120}" Stretch="Uniform" />
                                                                                                    </Border>
                                                                                                    <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#C8C8D8" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,2" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                                                                    <TextBlock Text="{Binding CountDisplay}" FontSize="11" FontWeight="Bold" Foreground="#FFA500" HorizontalAlignment="Center"
                                                                                                               Visibility="{Binding HasCount, Converter={StaticResource BoolToVis}}" />
                                                                                                </StackPanel>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </ScrollViewer>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <!-- ===== 意识故事 (accordion) ===== -->
                                                    <StackPanel Visibility="{Binding Consciousness.HasStories, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                                        <TextBlock Text="意识故事" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,0,0,6" />
                                                        <ItemsControl ItemsSource="{Binding Consciousness.Stories}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="#161622" BorderBrush="#2A2A3C" BorderThickness="1" Margin="0,0,0,6">
                                                                        <StackPanel>
                                                                            <Border Background="#1E1E2C" Padding="10,8" Tapped="OnConsciousnessStoryTap">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                                    <TextBlock Grid.Column="1" Text="{Binding ExpandGlyph}" FontFamily="Segoe UI Symbol" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" VerticalAlignment="Center" />
                                                                                </Grid>
                                                                            </Border>
                                                                            <Border Padding="10,8" Visibility="{Binding BodyVisibility}">
                                                                                <TextBlock Text="{Binding Body}" FontSize="12" Foreground="#C8C8D8" LineHeight="19" TextWrapping="Wrap"
                                                                                           Visibility="{Binding HasBody, Converter={StaticResource BoolToVis}}" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <!-- ===== 意识使用心得 (tip cards) ===== -->
                                                    <StackPanel Visibility="{Binding Consciousness.HasTips, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Consciousness.TipsTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,0,0,6"
                                                                   Visibility="{Binding Consciousness.TipsTitle, Converter={StaticResource NullToVis}}" />
                                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                            <ItemsControl ItemsSource="{Binding Consciousness.Tips}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="#1A1A26" BorderBrush="#2C2C3E" BorderThickness="1" Padding="8" Margin="0,0,8,0" Width="140">
                                                                            <StackPanel>
                                                                                <Border Background="#101016" Height="72" Margin="0,0,0,6"
                                                                                        Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                                                                                    <Image Source="{Binding IconUrl, Converter={StaticResource ImageCache}, ConverterParameter=280}" Stretch="Uniform" />
                                                                                </Border>
                                                                                <TextBlock Text="{Binding Title}" FontSize="11" Foreground="#D0D0DC" TextWrapping="Wrap" TextAlignment="Center"
                                                                                           Visibility="{Binding HasTitle, Converter={StaticResource BoolToVis}}" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- 2. TABS COMPONENT -->
                                                <StackPanel Visibility="{Binding HasTabs, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                                                    <!-- Component Header with Collapsible Toggle -->
                                                    <Grid Margin="0,0,0,6" Tapped="OnComponentHeaderTap" Background="Transparent" Visibility="{Binding Title, Converter={StaticResource NullToVis}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MetroAccentBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ExpandGlyph}" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="{StaticResource MetroSubTextBrush}"
                                                                   VerticalAlignment="Center" Visibility="{Binding CanCollapse, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>

                                                    <StackPanel Visibility="{Binding BodyVisibility}">
                                                        <!-- Tab Header / Selector -->
                                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                                                            <ItemsControl ItemsSource="{Binding Tabs}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Background="{Binding IsSelected, Converter={StaticResource BoolToAccentConverter}}"
                                                                                Foreground="{Binding IsSelected, Converter={StaticResource BoolToTextBrushConverter}}"
                                                                                BorderThickness="0" Padding="12,6" Margin="0,0,6,0" Click="OnTabButtonClick">
                                                                            <TextBlock Text="{Binding Title}" FontSize="12" />
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>

                                                         <!-- Active Tab Content Area -->
                                                        <Border Background="#161620" BorderBrush="#282836" BorderThickness="1" Padding="10">
                                                            <StackPanel>
                                                                <!-- 2.1 Big Top Illustration (e.g. 涂装 big art / gif) -->
                                                                <Border Background="#101016" Margin="0,0,0,10" Visibility="{Binding HasActiveTabBigImage, Converter={StaticResource BoolToVis}}">
                                                                    <Image helpers:KuroGifHelper.GifSource="{Binding ActiveTabBigImage}"
                                                                           Source="{Binding ActiveTabBigImage, Converter={StaticResource ImageCache}, ConverterParameter=720}" Stretch="Uniform" />
                                                                </Border>

                                                                <!-- 2.2 Structured Skill Rows (e.g. 信号球, 主动技能, 被动技能, 升阶效果) -->
                                                                <ItemsControl ItemsSource="{Binding ActiveTabSkillRows}" Visibility="{Binding HasActiveTabSkillRows, Converter={StaticResource BoolToVis}}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="#1A1A26" BorderBrush="#2C2C3E" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <!-- Left: Skill Icon & Name -->
                                                                                    <StackPanel Width="76" Margin="0,0,10,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                                                                        <Border Width="60" Height="60" Background="#121218" BorderBrush="#38384C" BorderThickness="1" HorizontalAlignment="Center"
                                                                                                Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                                                                                            <Image Source="{Binding IconUrl, Converter={StaticResource ImageCache}, ConverterParameter=120}" Stretch="Uniform" />
                                                                                        </Border>
                                                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
                                                                                    </StackPanel>

                                                                                    <!-- Right: Skill Description (Rich Colored) -->
                                                                                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                                        <RichTextBlock helpers:InlineRunsHelper.RunsSource="{Binding Runs}" FontSize="11" Foreground="#D0D0DC" LineHeight="17" />
                                                                                    </ScrollViewer>
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <!-- 2.3 Interactive Accordion Sections (e.g. 资料 编号1~6, 秘闻 1~12, 技能演示 招式1~2) -->
                                                                <ItemsControl ItemsSource="{Binding ActiveTabSections}" Visibility="{Binding HasActiveTabSections, Converter={StaticResource BoolToVis}}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="#161622" BorderBrush="#2A2A3C" BorderThickness="1" Margin="0,0,0,8">
                                                                                <StackPanel>
                                                                                    <!-- Accordion Header Button -->
                                                                                    <Border Background="#1E1E2C" Padding="10,8" Tapped="OnSectionHeaderTap">
                                                                                        <Grid>
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="*" />
                                                                                                <ColumnDefinition Width="Auto" />
                                                                                                <ColumnDefinition Width="20" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                                            <TextBlock Grid.Column="1" Text="{Binding Subtitle}" FontSize="10" Foreground="#FFA500" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                                                       Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}" />
                                                                                            <TextBlock Grid.Column="2" Text="{Binding ExpandGlyph}" FontFamily="Segoe UI Symbol" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" VerticalAlignment="Center" />
                                                                                        </Grid>
                                                                                    </Border>

                                                                                    <!-- Accordion Body -->
                                                                                    <Border Padding="10,8" Visibility="{Binding ContentVisibility}">
                                                                                        <StackPanel>
                                                                                            <!-- Rich text description with colors -->
                                                                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,6"
                                                                                                          Visibility="{Binding HasRuns, Converter={StaticResource BoolToVis}}">
                                                                                                <RichTextBlock helpers:InlineRunsHelper.RunsSource="{Binding Runs}" FontSize="11" Foreground="#C8C8D8" LineHeight="17" />
                                                                                            </ScrollViewer>

                                                                                            <!-- Preview GIF / Image (支持动态 GIF 流畅播放) -->
                                                                                            <Border Background="#101016" Margin="0,0,0,6" Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                                                                                                <Image helpers:KuroGifHelper.GifSource="{Binding ImageUrl}"
                                                                                                       Source="{Binding ImageUrl, Converter={StaticResource ImageCache}, ConverterParameter=480}" Stretch="Uniform" MaxHeight="240" />
                                                                                            </Border>

                                                                                            <!-- Nested Children Accordion Items (e.g. 招式1, 招式2) -->
                                                                                            <ItemsControl ItemsSource="{Binding Children}" Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}">
                                                                                                <ItemsControl.ItemTemplate>
                                                                                                    <DataTemplate>
                                                                                                        <Border Background="#14141E" BorderBrush="#262636" BorderThickness="1" Padding="8" Margin="0,0,0,6">
                                                                                                            <StackPanel>
                                                                                                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MetroAccentBrush}" Margin="0,0,0,4" />
                                                                                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,4"
                                                                                                                              Visibility="{Binding HasRuns, Converter={StaticResource BoolToVis}}">
                                                                                                                    <RichTextBlock helpers:InlineRunsHelper.RunsSource="{Binding Runs}" FontSize="11" Foreground="#B0B0C0" LineHeight="16" />
                                                                                                                </ScrollViewer>
                                                                                                                <Border Background="#0C0C12" Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                                                                                                                    <Image helpers:KuroGifHelper.GifSource="{Binding ImageUrl}"
                                                                                                                           Source="{Binding ImageUrl, Converter={StaticResource ImageCache}, ConverterParameter=480}" Stretch="Uniform" MaxHeight="200" />
                                                                                                                </Border>
                                                                                                            </StackPanel>
                                                                                                        </Border>
                                                                                                    </DataTemplate>
                                                                                                </ItemsControl.ItemTemplate>
                                                                                            </ItemsControl>
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <!-- 2.4 Voice Rows (e.g. 角色语音 lines) -->
                                                                <ItemsControl ItemsSource="{Binding ActiveTabVoiceRows}" Visibility="{Binding HasActiveTabVoiceRows, Converter={StaticResource BoolToVis}}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="#1A1A26" BorderBrush="#28283A" BorderThickness="1" Padding="8,6" Margin="0,0,0,6">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="84" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <!-- Tag / Action badge -->
                                                                                    <Border Background="#252538" Padding="4,2" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                                                        <TextBlock Text="{Binding Tag}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MetroAccentBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                                                                                    </Border>
                                                                                    <!-- Dialogue script (Rich Colored) -->
                                                                                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                                        <RichTextBlock helpers:InlineRunsHelper.RunsSource="{Binding Runs}" FontSize="11" Foreground="#DCDCE8" LineHeight="17" />
                                                                                    </ScrollViewer>
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <!-- 2.4.0 Structured Rotation Flow View (角色输出流程 - 支持左右滑动查看完整连招步骤) -->
                                                                <StackPanel Visibility="{Binding HasActiveTabRotationLines, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                                                    <ItemsControl ItemsSource="{Binding ActiveTabRotationLines}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Background="#161622" BorderBrush="#2A2A3C" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                                                                    <StackPanel>
                                                                                        <!-- Flow Title / Header Badge -->
                                                                                        <Border Background="#007ACC" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,6"
                                                                                                Visibility="{Binding Title, Converter={StaticResource NullToVis}}">
                                                                                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                                                                        </Border>

                                                                                        <!-- Swipeable / Scrollable Step Chips Sequence (横向滑动查看连招卡片) -->
                                                                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,2,0,8"
                                                                                                      Visibility="{Binding HasSteps, Converter={StaticResource BoolToVis}}">
                                                                                            <ItemsControl ItemsSource="{Binding Steps}">
                                                                                                <ItemsControl.ItemsPanel>
                                                                                                    <ItemsPanelTemplate>
                                                                                                        <StackPanel Orientation="Horizontal" />
                                                                                                    </ItemsPanelTemplate>
                                                                                                </ItemsControl.ItemsPanel>
                                                                                                <ItemsControl.ItemTemplate>
                                                                                                    <DataTemplate>
                                                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                                            <Border Background="#202030" BorderBrush="#3A3A52" BorderThickness="1" Padding="8,5" Margin="0,0,4,0">
                                                                                                                <StackPanel Orientation="Horizontal">
                                                                                                                    <Border Background="#FF8C00" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                                                                        <TextBlock Text="{Binding StepIndex}" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                                                    </Border>
                                                                                                                    <TextBlock Text="{Binding StepText}" FontSize="11" Foreground="White" VerticalAlignment="Center" />
                                                                                                                </StackPanel>
                                                                                                            </Border>
                                                                                                            <TextBlock Text="→" FontSize="14" Foreground="#7E8C8D" Margin="2,0,6,0" VerticalAlignment="Center" />
                                                                                                        </StackPanel>
                                                                                                    </DataTemplate>
                                                                                                </ItemsControl.ItemTemplate>
                                                                                            </ItemsControl>
                                                                                        </ScrollViewer>

                                                                                        <!-- Rich Colored Text Description (API 文字颜色完整呈现，支持左右横向滚动) -->
                                                                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                                                                      Visibility="{Binding HasRuns, Converter={StaticResource BoolToVis}}">
                                                                                            <RichTextBlock helpers:InlineRunsHelper.RunsSource="{Binding Runs}" FontSize="11" Foreground="#C8C8D8" LineHeight="17" />
                                                                                        </ScrollViewer>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>

                                                                <!-- 2.4.1 Structured Equip & Team Recommendation Cards (推荐意识/武器/配队卡片) -->
                                                                <ItemsControl ItemsSource="{Binding ActiveTabEquipGroups}" Visibility="{Binding HasActiveTabEquipGroups, Converter={StaticResource BoolToVis}}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Margin="0,0,0,10">
                                                                                <!-- Group Title (e.g. 推荐意识套装 / 武器共鸣推荐 / 推荐队伍搭配) -->
                                                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MetroAccentBrush}" Margin="0,0,0,6"
                                                                                           Visibility="{Binding Title, Converter={StaticResource NullToVis}}" />

                                                                                <!-- Equip / Role Items -->
                                                                                <ItemsControl ItemsSource="{Binding Items}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Border Background="#1A1A26" BorderBrush="#2C2C3E" BorderThickness="1" Padding="8" Margin="0,0,0,6"
                                                                                                    Tapped="OnEquipRecommendItemClick">
                                                                                                <Grid>
                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="Auto" />
                                                                                                        <ColumnDefinition Width="*" />
                                                                                                        <ColumnDefinition Width="Auto" />
                                                                                                    </Grid.ColumnDefinitions>

                                                                                                    <!-- Item Icon -->
                                                                                                    <Border Grid.Column="0" Width="48" Height="48" Background="#121218" BorderBrush="#38384C" BorderThickness="1" Margin="0,0,10,0"
                                                                                                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                                                                                                        <Image Source="{Binding IconUrl, Converter={StaticResource ImageCache}, ConverterParameter=120}" Stretch="Uniform" />
                                                                                                    </Border>

                                                                                                    <!-- Item Name, Category, Note, SubInfo -->
                                                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                                        <StackPanel Orientation="Horizontal">
                                                                                                            <Border Background="#007ACC" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                                                                    Visibility="{Binding Category, Converter={StaticResource NullToVis}}">
                                                                                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                                                                                            </Border>
                                                                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                                                        </StackPanel>

                                                                                                        <!-- Note (e.g. 定位: 输出 治疗增益 | 推荐: SS+终阶) -->
                                                                                                        <TextBlock Text="{Binding Note}" FontSize="11" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,3,0,0"
                                                                                                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />

                                                                                                        <!-- SubInfo (e.g. 6星武器 不孤航炬 • 辅助机 【凯尔派】) -->
                                                                                                        <TextBlock Text="{Binding SubInfo}" FontSize="11" Foreground="#4FC3F7" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                                                                   Visibility="{Binding HasSubInfo, Converter={StaticResource BoolToVis}}" />

                                                                                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,2,0,0"
                                                                                                                      Visibility="{Binding HasRuns, Converter={StaticResource BoolToVis}}">
                                                                                                            <RichTextBlock helpers:InlineRunsHelper.RunsSource="{Binding Runs}" FontSize="10" Foreground="{StaticResource MetroSubTextBrush}" LineHeight="15" />
                                                                                                        </ScrollViewer>
                                                                                                    </StackPanel>

                                                                                                    <!-- Count Badge (e.g. *4, *2) -->
                                                                                                    <Border Grid.Column="2" Background="#2A2A3E" Padding="8,4" VerticalAlignment="Center" Margin="6,0,0,0"
                                                                                                            Visibility="{Binding Count, Converter={StaticResource NullToVis}}">
                                                                                                        <TextBlock Text="{Binding Count}" FontSize="12" FontWeight="Bold" Foreground="#FFA500" />
                                                                                                    </Border>
                                                                                                </Grid>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>

                                                                                <!-- Tip / Advice Box (if any with Rich API colors) -->
                                                                                <Border Background="#141420" BorderBrush="#242436" BorderThickness="1" Padding="8,6" Margin="0,2,0,0"
                                                                                        Visibility="{Binding Tip, Converter={StaticResource NullToVis}}">
                                                                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                                                        <RichTextBlock helpers:InlineRunsHelper.RunsSource="{Binding TipRuns}" FontSize="11" Foreground="#A0A0B8" LineHeight="16" />
                                                                                    </ScrollViewer>
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <!-- 2.5 Link / External Entry Card (e.g. 好感剧情) -->
                                                                <Border Background="#1A2230" BorderBrush="#007ACC" BorderThickness="1" Padding="12,10" Margin="0,0,0,8"
                                                                        Visibility="{Binding HasActiveTabLink, Converter={StaticResource BoolToVis}}"
                                                                        Tapped="OnActiveTabLinkTap">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding ActiveTabLinkTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#4FC3F7" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                        <TextBlock Grid.Column="1" Text="" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="{StaticResource MetroAccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                    </Grid>
                                                                </Border>

                                                                <!-- 2.6 Simple Rich Text & Images Fallback (API 原始富文本色彩) -->
                                                                <StackPanel Visibility="{Binding HasActiveTabSimpleText, Converter={StaticResource BoolToVis}}">
                                                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8"
                                                                                  Visibility="{Binding HasActiveTabRuns, Converter={StaticResource BoolToVis}}">
                                                                        <RichTextBlock helpers:InlineRunsHelper.RunsSource="{Binding ActiveTabRuns}" FontSize="12" Foreground="#D0D0DC" LineHeight="19" />
                                                                    </ScrollViewer>
                                                                    <ItemsControl ItemsSource="{Binding ActiveTabImages}" Visibility="{Binding HasActiveTabImages, Converter={StaticResource BoolToVis}}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Background="#101018" Margin="0,0,0,6">
                                                                                    <Image helpers:KuroGifHelper.GifSource="{Binding}" Source="{Binding Converter={StaticResource ImageCache}}" Stretch="Uniform" MaxHeight="300" />
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- 3. STRATEGY COMPONENT -->
                                                <StackPanel Visibility="{Binding HasStrategies, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MetroAccentBrush}" Margin="0,0,0,6"
                                                               Visibility="{Binding Title, Converter={StaticResource NullToVis}}" />
                                                    <ItemsControl ItemsSource="{Binding Strategies}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Background="#1A1A26" BorderBrush="#2C2C3E" BorderThickness="1" Margin="0,0,0,8" Padding="0"
                                                                        HorizontalContentAlignment="Stretch" Click="OnStrategyItemClick">
                                                                    <Grid Height="80">
                                                                        <Image helpers:KuroGifHelper.GifSource="{Binding BgUrl}" Source="{Binding BgUrl, Converter={StaticResource ImageCache}}" Stretch="UniformToFill" Opacity="0.5" />
                                                                        <Border Background="#B0000000" VerticalAlignment="Bottom" Padding="10,6">
                                                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <!-- 4. AUDIO / VOICE COMPONENT -->
                                                <StackPanel Visibility="{Binding HasAudios, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                                    <ItemsControl ItemsSource="{Binding AudioTabs}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,0,8">
                                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,0,0,4" />
                                                                    <ItemsControl ItemsSource="{Binding Audios}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Background="#181822" BorderBrush="#2C2C3E" BorderThickness="1" Padding="10,6" Margin="0,0,0,4">
                                                                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                                                        <TextBlock Text="{Binding Script}" FontSize="11" Foreground="#D0D0DC" LineHeight="17" />
                                                                                    </ScrollViewer>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <!-- 5. DEFAULT TEXT & BASIC COMPONENT (Fallback with Rich API Colors) -->
                                                <StackPanel Visibility="{Binding HasCleanText, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                                    <!-- Component Subtitle -->
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"
                                                               Visibility="{Binding Title, Converter={StaticResource NullToVis}}" />

                                                    <!-- Clean Formatted Text with Colors -->
                                                    <Border Background="#161620" BorderBrush="#282836" BorderThickness="1" Padding="10" Margin="0,0,0,6">
                                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                            <RichTextBlock helpers:InlineRunsHelper.RunsSource="{Binding Runs}" FontSize="12" Foreground="#D0D0DC" LineHeight="19" />
                                                        </ScrollViewer>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Single Image (if standalone image component) -->
                                                <Border Background="#141418" Margin="0,0,0,6" Visibility="{Binding HasSingleImage, Converter={StaticResource BoolToVis}}">
                                                    <Image helpers:KuroGifHelper.GifSource="{Binding ImageUrl}" Source="{Binding ImageUrl, Converter={StaticResource ImageCache}}" Stretch="Uniform" MaxHeight="300" />
                                                </Border>

                                                <!-- Image List (if not in tabs/role) -->
                                                <ItemsControl ItemsSource="{Binding ImageList}" Visibility="{Binding HasImages, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#141418" Margin="0,0,0,6">
                                                                <Image helpers:KuroGifHelper.GifSource="{Binding}" Source="{Binding Converter={StaticResource ImageCache}}" Stretch="Uniform" MaxHeight="260" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Contributors to this Entry -->
                <StackPanel Visibility="{Binding Contributors.Count, Converter={StaticResource NullToVis}}" Margin="0,10,0,16">
                    <TextBlock Text="本条目贡献者" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,0,0,8" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Contributors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A1A22" Padding="8,4" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="24" Height="24" Background="#141418" Margin="0,0,6,0">
                                                <Image Source="{Binding UserHeadUrl, Converter={StaticResource ImageCache}}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Text="{Binding UserName}" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
