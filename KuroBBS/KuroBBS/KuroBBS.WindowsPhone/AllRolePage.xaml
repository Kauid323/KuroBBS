<Page
    x:Name="AllRoleRoot"
    x:Class="KuroBBS.AllRolePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:KuroBBS.Helpers"
    xmlns:models="using:KuroBBS.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.BottomAppBar>
        <CommandBar Background="#121216" ClosedDisplayMode="Minimal" IsOpen="False">
            <AppBarButton Icon="Back" Label="返回" Click="OnBackClick" />
            <AppBarButton Icon="Refresh" Label="刷新" Command="{Binding RefreshCommand}" />
        </CommandBar>
    </Page.BottomAppBar>

    <Grid>
        <!-- Native Metro Progress Indicator -->
        <ProgressBar VerticalAlignment="Top" IsIndeterminate="{Binding IsBusy}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                     Foreground="{StaticResource MetroAccentBrush}" Canvas.ZIndex="99" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,0,16,24">
                <!-- Metro Page Title Area -->
                <StackPanel Margin="0,14,0,12">
                    <Grid>
                        <TextBlock Text="战双帕弥什 · 角色列表" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" />
                        <TextBlock Text="{Binding Roles.Count, Converter={StaticResource StringFormatConverter}, ConverterParameter='共 {0} 位构造体'}"
                                   FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="角色列表" FontSize="32" FontWeight="Light" Foreground="White" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Status / Empty Message -->
                <TextBlock Text="{Binding StatusMessage}"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}"
                           FontSize="13" Foreground="{StaticResource MetroSubTextBrush}"
                           HorizontalAlignment="Center" Margin="0,30,0,0" TextWrapping="Wrap" />

                <!-- Pure Metro WrapGrid of Character Tiles -->
                <ItemsControl ItemsSource="{Binding Roles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapGrid Orientation="Horizontal"
                                      ItemWidth="{Binding CardWidth}"
                                      ItemHeight="{Binding CardHeight}"
                                      MaximumRowsOrColumns="{Binding RoleColumns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,6,6" Background="{StaticResource MetroCardBackgroundBrush}"
                                  Tag="{Binding}" Tapped="OnCharacterCardTapped">
                                <Border BorderBrush="#2C2C36" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <!-- Top: Avatar Image -->
                                            <RowDefinition Height="*" />
                                            <!-- Bottom: Typography Info -->
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Top: Avatar Image -->
                                        <Grid Grid.Row="0" Background="#141418">
                                            <Image Source="{Binding IconUrl, Converter={StaticResource ImageCacheConverter}}"
                                                   Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <!-- Level Badge (Top Left) -->
                                            <Border Visibility="{Binding Level, Converter={StaticResource NullToVis}}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Background="#CC000000" Padding="4,1">
                                                <TextBlock Text="{Binding LevelText}" FontSize="9" Foreground="White" />
                                            </Border>

                                            <!-- Metro Rank Badge (Top Right) -->
                                            <Border Visibility="{Binding RankText, Converter={StaticResource NullToVis}}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Background="#D0000000" Padding="5,1">
                                                <TextBlock Text="{Binding RankText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MetroGoldBrush}" />
                                            </Border>

                                            <!-- Element (Bottom Left) -->
                                            <Border Visibility="{Binding Element, Converter={StaticResource NullToVis}}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    Background="#CC000000" Padding="4,1">
                                                <TextBlock Text="{Binding Element}" FontSize="9" Foreground="#66CCFF" />
                                            </Border>
                                        </Grid>

                                        <!-- Bottom: Metro Typography Info -->
                                        <Border Grid.Row="1" Background="#181820" Padding="5,4" BorderBrush="#262630" BorderThickness="0,1,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding BodyName}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="White" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding FightAbilityText}" Visibility="{Binding FightAbilityText, Converter={StaticResource NullToVis}}"
                                                           FontSize="9" Foreground="{StaticResource MetroAccentBrush}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
