<Page
    x:Class="KuroBBS.UserProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KuroBBS"
    xmlns:helpers="using:KuroBBS.Helpers"
    xmlns:models="using:KuroBBS.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.BottomAppBar>
        <CommandBar x:Name="BottomBar" Background="#121216" ClosedDisplayMode="Minimal" IsOpen="False">
            <AppBarButton Icon="Back" Label="返回" Click="OnBackClick" />
            <AppBarButton Icon="{Binding Profile.FollowButtonIcon, Converter={StaticResource StringToSymbolIcon}}" Label="{Binding Profile.FollowButtonLabel}" Command="{Binding ToggleFollowCommand}" Visibility="{Binding CanFollow, Converter={StaticResource BoolToVis}}" />
            <AppBarButton Icon="Refresh" Label="刷新" Command="{Binding RefreshCommand}" />
        </CommandBar>
    </Page.BottomAppBar>

    <Grid x:Name="RootLayoutGrid">
        <!-- Native Progress Indicator -->
        <ProgressBar VerticalAlignment="Top" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource MetroAccentBrush}" Canvas.ZIndex="999" />

        <Grid Margin="16,0,16,0">
            <Grid.RowDefinitions>
                <!-- Row 0: User Profile Header Card -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Pivot for Posts & Info -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- User Header Card (Metro Style) -->
            <Grid Grid.Row="0" Margin="0,14,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Row: Avatar + Name + Follow Button -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Avatar with caching (Tap for Image Viewer) -->
                    <Border Grid.Column="0" Width="64" Height="64" Background="#282832" Margin="0,0,14,0" VerticalAlignment="Center" Tapped="OnAvatarTapped">
                        <Grid>
                            <TextBlock Text="K" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="22" Foreground="#8E8E93" />
                            <Ellipse Width="64" Height="64">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding Profile.AvatarUrl, Converter={StaticResource ImageCacheConverter}}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                    </Border>

                    <!-- User Info Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Profile.UserName}" FontWeight="Bold" FontSize="18" Foreground="White" TextTrimming="CharacterEllipsis" />
                        
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Background="#20FFFFFF" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="{Binding Profile.IpRegion, Converter={StaticResource StringFormatConverter}, ConverterParameter='IP: {0}'}" FontSize="10" Foreground="#B0B0C0" />
                            </Border>
                            <Border Background="#1A00A3FF" Padding="6,2">
                                <TextBlock Text="{Binding Profile.UserId, Converter={StaticResource StringFormatConverter}, ConverterParameter='UID: {0}'}" FontSize="10" Foreground="#00A3FF" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Profile.Signature}" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Follow Button (Visible for other users) -->
                    <Button Grid.Column="2" 
                            Command="{Binding ToggleFollowCommand}" 
                            Visibility="{Binding CanFollow, Converter={StaticResource BoolToVis}}" 
                            Background="{Binding Profile.IsFollow, Converter={StaticResource FollowStateToBgConverter}}" 
                            Foreground="{Binding Profile.IsFollow, Converter={StaticResource FollowStateToFgConverter}}" 
                            FontWeight="SemiBold" 
                            FontSize="12" 
                            Height="34" 
                            Padding="14,0" 
                            BorderThickness="0" 
                            VerticalAlignment="Center" 
                            Margin="8,0,0,0">
                        <TextBlock Text="{Binding Profile.FollowButtonLabel}" />
                    </Button>
                </Grid>

                <!-- Bottom Row: Stats Summary Bar (3 Items: 获赞, 关注, 粉丝) -->
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="4,4">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Profile.LikeCount}" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" />
                            <TextBlock Text="获赞" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Padding="4,4" IsTapEnabled="True" Tapped="OnFollowingTapped">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Profile.FollowingCount}" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" />
                            <TextBlock Text="关注" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Padding="4,4">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Profile.FansCount}" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" />
                            <TextBlock Text="粉丝" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Main Pivot Container (Pure Native Metro Pivot) -->
            <Pivot Grid.Row="1" x:Name="UserPivot" Margin="-16,-4,-16,0" SelectionChanged="OnUserPivotSelectionChanged">
                <Pivot.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="20" FontWeight="SemiBold" Margin="0,0,14,0" />
                    </DataTemplate>
                </Pivot.HeaderTemplate>

                <!-- Tab 1: 动态 / 帖子 -->
                <PivotItem Header="动态" Margin="16,0,16,0">
                    <Grid>
                        <!-- Posts List -->
                        <ListView x:Name="UserPostsListView" 
                                  ItemsSource="{Binding Posts}" 
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="OnPostItemClick">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="30" />
                                    <AddDeleteThemeTransition />
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#181820" BorderBrush="#262632" BorderThickness="1" Padding="14,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Game & Tag Badge -->
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Background="#2000A3FF" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding GameName}" FontSize="10" Foreground="#00A3FF" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding PostTimeStr}" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Title -->
                                            <TextBlock Grid.Row="1" Text="{Binding Title}" FontWeight="Bold" FontSize="15" Foreground="White" MaxLines="2" TextWrapping="Wrap" Margin="0,0,0,6" />

                                            <!-- Summary Content -->
                                            <TextBlock Grid.Row="2" Text="{Binding ContentSummary}" FontSize="13" Foreground="#B0B0C0" MaxLines="3" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

                                            <!-- Post Footer Stats -->
                                            <Grid Grid.Row="3" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,14,0">
                                                    <TextBlock Text="♥" FontSize="12" Foreground="#FF453A" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding LikeCount}" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <TextBlock Text="💬" FontSize="12" Foreground="#00A3FF" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding CommentCount}" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty State -->
                        <StackPanel Visibility="{Binding HasNoPosts, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                            <TextBlock Text="📝" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="暂无发布的动态" FontSize="14" Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Loading State -->
                        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoadingPosts, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource MetroAccentBrush}" VerticalAlignment="Top" />
                    </Grid>
                </PivotItem>

                <!-- Tab 2: 收藏 -->
                <PivotItem Header="收藏" Margin="16,0,16,0">
                    <Grid>
                        <!-- Collections List -->
                        <ListView x:Name="UserCollectionsListView" 
                                  ItemsSource="{Binding Collections}" 
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="OnPostItemClick">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="30" />
                                    <AddDeleteThemeTransition />
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#181820" BorderBrush="#262632" BorderThickness="1" Padding="14,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Game & Tag Badge -->
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Background="#2000A3FF" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding GameName}" FontSize="10" Foreground="#00A3FF" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding Author.UserName}" FontSize="11" Foreground="#B0B0C0" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding PostTimeStr}" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Title -->
                                            <TextBlock Grid.Row="1" Text="{Binding Title}" FontWeight="Bold" FontSize="15" Foreground="White" MaxLines="2" TextWrapping="Wrap" Margin="0,0,0,6" />

                                            <!-- Summary Content -->
                                            <TextBlock Grid.Row="2" Text="{Binding ContentSummary}" FontSize="13" Foreground="#B0B0C0" MaxLines="3" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

                                            <!-- Post Footer Stats -->
                                            <Grid Grid.Row="3" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,14,0">
                                                    <TextBlock Text="♥" FontSize="12" Foreground="#FF453A" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding LikeCount}" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <TextBlock Text="💬" FontSize="12" Foreground="#00A3FF" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding CommentCount}" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty State -->
                        <StackPanel Visibility="{Binding HasNoCollections, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                            <TextBlock Text="⭐" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="暂无收藏的帖子" FontSize="14" Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Loading State -->
                        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoadingCollections, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource MetroAccentBrush}" VerticalAlignment="Top" />
                    </Grid>
                </PivotItem>

                <!-- Tab 3: 评论 -->
                <PivotItem Header="评论" Margin="16,0,16,0">
                    <Grid>
                        <!-- Comments List -->
                        <ListView x:Name="UserCommentsListView" 
                                  ItemsSource="{Binding UserComments}" 
                                  SelectionMode="None">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="30" />
                                    <AddDeleteThemeTransition />
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#181820" BorderBrush="#262632" BorderThickness="1" Padding="14,12">
                                        <StackPanel>
                                            <!-- Comment Header: Game & Time -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#2000A3FF" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding GameName}" FontSize="10" Foreground="#00A3FF" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Text="{Binding ShowTime}" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Comment Like Button (Compact & Aligned) -->
                                                <Button Grid.Column="1" 
                                                        Background="Transparent" 
                                                        BorderThickness="0" 
                                                        Padding="4,1" 
                                                        MinWidth="0"
                                                        MinHeight="0"
                                                        Margin="0"
                                                        VerticalAlignment="Center"
                                                        Click="OnCommentLikeButtonClick">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding LikeIcon}" Foreground="{Binding LikeColor}" FontSize="12" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding LikeCountText}" FontSize="11" Foreground="{Binding LikeColor}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <!-- Target User Indicator (if reply) -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Visibility="{Binding TargetUserName, Converter={StaticResource NullToVis}}">
                                                <TextBlock Text="回复 @" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" />
                                                <TextBlock Text="{Binding TargetUserName}" FontSize="11" Foreground="{StaticResource MetroAccentBrush}" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <!-- Comment Content with rich emojis -->
                                            <RichTextBlock helpers:InlineRunsHelper.RunsSource="{Binding ContentRuns}" 
                                                           FontSize="13.5" 
                                                           Foreground="#EAEAEA" 
                                                           TextWrapping="Wrap" 
                                                           Margin="0,2,0,8" 
                                                           LineHeight="18" 
                                                           IsTextSelectionEnabled="False" />

                                            <!-- Quoted Post Target Box (Click to open post) -->
                                            <Border Background="#20202A" 
                                                    BorderBrush="#2A2A38" 
                                                    BorderThickness="1" 
                                                    Padding="10,8" 
                                                    Tapped="OnCommentPostTapped" 
                                                    Tag="{Binding PostId}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <RichTextBlock Grid.Column="0" 
                                                                   helpers:InlineRunsHelper.RunsSource="{Binding TitleRuns}" 
                                                                   FontSize="12" 
                                                                   Foreground="#A0A0B0" 
                                                                   TextWrapping="Wrap" 
                                                                   LineHeight="16" 
                                                                   IsTextSelectionEnabled="False" />

                                                    <TextBlock Grid.Column="1" Text="原帖 ›" FontSize="11" Foreground="{StaticResource MetroAccentBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty State -->
                        <StackPanel Visibility="{Binding HasNoComments, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                            <TextBlock Text="💬" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="暂无发表的评论" FontSize="14" Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Loading State -->
                        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoadingComments, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource MetroAccentBrush}" VerticalAlignment="Top" />
                    </Grid>
                </PivotItem>

                <!-- Tab 4: 游戏角色 -->
                <PivotItem Header="角色" Margin="16,0,16,0">
                    <Grid>
                        <!-- Roles List -->
                        <ListView x:Name="UserRolesListView" 
                                  ItemsSource="{Binding GameRoles}" 
                                  SelectionMode="None">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="30" />
                                    <AddDeleteThemeTransition />
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Margin" Value="0,0,0,12" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#181820" BorderBrush="#262632" BorderThickness="1" Padding="14,14">
                                        <StackPanel>
                                            <!-- Top Header: Game Icon + Game Name + Server + Level + Default Badge -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Game Icon / Role Avatar -->
                                                <Border Grid.Column="0" Width="44" Height="44" Background="#282834" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <Grid>
                                                        <TextBlock Text="🎮" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8E8E93" />
                                                        <Ellipse Width="44" Height="44">
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource ImageCacheConverter}}" Stretch="UniformToFill" />
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                    </Grid>
                                                </Border>

                                                <!-- Role Info & Game Title -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding RoleName}" FontWeight="Bold" FontSize="16" Foreground="White" />
                                                        <Border Background="#2500A3FF" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="默认展示" FontSize="9.5" Foreground="{StaticResource MetroAccentBrush}" FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Border Background="#20FFFFFF" Padding="5,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding GameName}" FontSize="10" Foreground="#B0B0C0" />
                                                        </Border>
                                                        <TextBlock Text="{Binding ServerName}" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Level Badge -->
                                                <Border Grid.Column="2" Background="{StaticResource MetroAccentBrush}" Padding="8,3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding LevelDisplay}" FontSize="12" Foreground="White" FontWeight="Bold" />
                                                </Border>
                                            </Grid>

                                            <!-- Divider line -->
                                            <Border BorderBrush="#22222C" BorderThickness="0,0,0,1" Margin="0,0,0,10" />

                                            <!-- Role Details Grid (4 Game-Specific Stat Cards) -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Stat 1: 游戏天数 -->
                                                <Border Grid.Column="0" Background="#121218" Padding="4,6" Margin="0,0,3,0">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Stat1Value}" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Stat1Label}" FontSize="9.5" Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Stat 2: 战双(角色总评分) / 鸣潮(成就数) -->
                                                <Border Grid.Column="1" Background="#121218" Padding="4,6" Margin="2,0,2,0">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Stat2Value}" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Stat2Label}" FontSize="9.5" Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Stat 3: 角色数量 (构造体 / 共鸣者) -->
                                                <Border Grid.Column="2" Background="#121218" Padding="4,6" Margin="2,0,2,0">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Stat3Value}" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Stat3Label}" FontSize="9.5" Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Stat 4: 战双(涂装收集率) / 鸣潮(声骸收集进度) -->
                                                <Border Grid.Column="3" Background="#121218" Padding="4,6" Margin="3,0,0,0">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Stat4Value}" FontWeight="Bold" FontSize="13" Foreground="#00A3FF" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Stat4Label}" FontSize="9.5" Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Role ID Footer -->
                                            <TextBlock Text="{Binding RoleId, Converter={StaticResource StringFormatConverter}, ConverterParameter='角色 UID: {0}'}" FontSize="10.5" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty State -->
                        <StackPanel Visibility="{Binding HasNoRoles, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                            <TextBlock Text="🎮" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="暂无展示的游戏角色" FontSize="14" Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Loading State -->
                        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoadingRoles, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource MetroAccentBrush}" VerticalAlignment="Top" />
                    </Grid>
                </PivotItem>

                <!-- Tab 5: 详细资料 -->
                <PivotItem Header="资料" Margin="16,0,16,0">
                    <ScrollViewer>
                        <StackPanel Margin="0,6,0,24">
                            <!-- Basic Info Card -->
                            <Border Background="#181820" BorderBrush="#262632" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="基本信息" FontWeight="Bold" FontSize="14" Foreground="White" Margin="0,0,0,10" />

                                    <Grid Margin="0,4,0,4">
                                        <TextBlock Text="用户昵称" FontSize="13" Foreground="{StaticResource MetroSubTextBrush}" />
                                        <TextBlock Text="{Binding Profile.UserName}" FontSize="13" Foreground="White" HorizontalAlignment="Right" />
                                    </Grid>

                                    <Grid Margin="0,4,0,4">
                                        <TextBlock Text="用户 UID" FontSize="13" Foreground="{StaticResource MetroSubTextBrush}" />
                                        <TextBlock Text="{Binding Profile.UserId}" FontSize="13" Foreground="#00A3FF" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    </Grid>

                                    <Grid Margin="0,4,0,4">
                                        <TextBlock Text="IP 属地" FontSize="13" Foreground="{StaticResource MetroSubTextBrush}" />
                                        <TextBlock Text="{Binding Profile.IpRegion}" FontSize="13" Foreground="White" HorizontalAlignment="Right" />
                                    </Grid>

                                    <Grid Margin="0,4,0,4" Visibility="{Binding Profile.RegisterTime, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="注册时间" FontSize="13" Foreground="{StaticResource MetroSubTextBrush}" />
                                        <TextBlock Text="{Binding Profile.RegisterTime}" FontSize="13" Foreground="White" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Game Roles Card (if any) -->
                            <Border Background="#181820" BorderBrush="#262632" BorderThickness="1" Padding="14" Visibility="{Binding HasGameRoles, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="绑定游戏角色" FontWeight="Bold" FontSize="14" Foreground="White" Margin="0,0,0,10" />

                                    <ItemsControl ItemsSource="{Binding GameRoles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#20202A" Padding="10,8" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Width="36" Height="36" Background="#333340" Margin="0,0,10,0">
                                                            <Ellipse Width="36" Height="36">
                                                                <Ellipse.Fill>
                                                                    <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource ImageCacheConverter}}" Stretch="UniformToFill" />
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RoleName}" FontWeight="Bold" FontSize="13" Foreground="White" />
                                                            <TextBlock Text="{Binding ServerName}" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" />
                                                        </StackPanel>

                                                        <Border Grid.Column="2" Background="{StaticResource MetroAccentBrush}" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LevelDisplay}" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
            </Pivot>
        </Grid>

        <!-- Full-screen Metro Image Viewer Modal Layer -->
        <Grid x:Name="ImageViewerOverlay"
              Visibility="{Binding IsImageViewerOpen, Converter={StaticResource BoolToVis}}"
              Background="#FA000000"
              Canvas.ZIndex="1000"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <!-- Pinch-to-zoom / Pan ScrollViewer -->
            <ScrollViewer x:Name="ImageViewerScrollViewer"
                          ZoomMode="Enabled"
                          MinZoomFactor="1.0"
                          MaxZoomFactor="4.0"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollMode="Enabled"
                          DoubleTapped="OnImageViewerDoubleTapped"
                          Tapped="OnImageViewerBackgroundTapped">
                <Grid x:Name="ImageViewerContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="ViewerImage"
                           Source="{Binding SelectedImageUrl, Converter={StaticResource ImageCacheConverter}}"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           ImageOpened="OnViewerImageOpened" />
                </Grid>
            </ScrollViewer>

            <!-- Top Minimal Floating Toolbar (Save & Close) -->
            <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="12,12,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Save Button -->
                <Button Grid.Column="1"
                        Click="OnSaveImageClick"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Padding="10,6"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" FontSize="14" Foreground="#00A3FF" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="保存" FontSize="14" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Close Button -->
                <Button Grid.Column="2"
                        Click="OnImageViewerCloseClick"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Padding="10,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✕" FontSize="14" Foreground="#FF453A" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="关闭" FontSize="14" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Save Notification Toast Banner -->
            <Border x:Name="SaveToastBorder"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,48"
                    Background="#E61C1C24"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    Padding="18,10">
                <TextBlock x:Name="SaveToastText" Text="已保存到相册" FontSize="13" Foreground="White" FontWeight="Medium" />
            </Border>
        </Grid>
    </Grid>
</Page>
