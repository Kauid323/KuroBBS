<Page
    x:Class="KuroBBS.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#B8C9DB">

    <Page.Resources>
        <SolidColorBrush x:Key="PagePanelBrush" Color="#E8F1F7" />
        <SolidColorBrush x:Key="PageSectionBrush" Color="#0E2A40" />
        <SolidColorBrush x:Key="PageTextBrush" Color="#1E2A35" />
        <SolidColorBrush x:Key="PageMutedBrush" Color="#667784" />
        <SolidColorBrush x:Key="PageBlueBrush" Color="#087DC4" />
    </Page.Resources>

    <Page.BottomAppBar>
        <CommandBar Background="#0B1B2A" ClosedDisplayMode="Minimal" IsOpen="False">
            <AppBarButton Icon="Back" Label="返回" Click="OnBackClick" />
        </CommandBar>
    </Page.BottomAppBar>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,10,16,24">
                <Border Height="78" Background="#0B1B2A" Margin="-16,-10,-16,14" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="设置" FontSize="25" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="WP8.1 Metro 显示选项" FontSize="12" Foreground="#AFC0CD" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <Border Height="38" Background="{StaticResource PageSectionBrush}" BorderBrush="#E5F0F7" BorderThickness="1" Padding="10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="18" Background="{StaticResource PageBlueBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="角色图鉴" FontSize="16" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PagePanelBrush}" BorderBrush="#D5E3EC" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="每行显示数量" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PageTextBrush}" />
                        <TextBlock Text="调整全部角色、图鉴与意识手册列表、金币商店的卡片列数，设置会自动保存。" FontSize="11" Foreground="{StaticResource PageMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,10" />
                        <ComboBox ItemsSource="{Binding ColumnOptions}" SelectedItem="{Binding GridColumns, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="#F4F8FB" Foreground="{StaticResource PageTextBrush}" BorderBrush="#A9C6D8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="14" Foreground="{StaticResource PageTextBrush}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding ColumnSummary}" FontSize="12" Foreground="{StaticResource PageBlueBrush}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- 缓存管理 -->
                <Border Height="38" Background="{StaticResource PageSectionBrush}" BorderBrush="#E5F0F7" BorderThickness="1" Padding="10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="18" Background="{StaticResource PageBlueBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="存储与缓存" FontSize="16" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PagePanelBrush}" BorderBrush="#D5E3EC" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="本地临时缓存" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PageTextBrush}" />
                        <TextBlock Text="清理应用在运行过程中缓存的帖子图片、表情包与离线数据，释放手机存储空间。" FontSize="11" Foreground="{StaticResource PageMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,10" />
                        <TextBlock Text="{Binding CacheSizeSummary}" FontSize="13" Foreground="{StaticResource PageBlueBrush}" Margin="0,0,0,12" />
                        <Button Content="清理全部缓存" Command="{Binding ClearCacheCommand}" HorizontalAlignment="Stretch" Background="#0E2A40" Foreground="White" BorderBrush="#087DC4" Height="42" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
