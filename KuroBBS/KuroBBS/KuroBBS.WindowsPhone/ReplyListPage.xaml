<Page
    x:Class="KuroBBS.ReplyListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KuroBBS"
    xmlns:helpers="using:KuroBBS.Helpers"
    xmlns:models="using:KuroBBS.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.BottomAppBar>
        <CommandBar x:Name="BottomBar" Background="#121216" ClosedDisplayMode="Minimal" IsOpen="False">
            <AppBarButton Icon="Back" Label="返回" Click="OnBackClick" />
            <AppBarButton Icon="Refresh" Label="刷新" Click="OnRefreshClick" />
            <AppBarButton x:Name="GoToPostButton" Icon="Forward" Label="原贴" Click="OnGoToPostClick" />
        </CommandBar>
    </Page.BottomAppBar>

    <Grid>
        <ProgressBar VerticalAlignment="Top" IsIndeterminate="{Binding IsBusy}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                     Foreground="{StaticResource MetroAccentBrush}" Canvas.ZIndex="999" />

        <Grid Margin="12,8,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 被回复的原评论 -->
            <Border Grid.Row="0" Background="#1E1E24" Padding="12,10" Margin="0,0,0,8" VerticalAlignment="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- 圆形头像：WinRT 的 Image 裁不成圆，必须用 ImageBrush。
                         这里**必须**用 ImageCacheConverter（全 app 统一的头像方案）：
                         KuroLazyImage.SourceUrl 附加属性只认 Image 元素，挂到 ImageBrush 上
                         会静默什么都不做 → 头像永远不加载（就是之前"头像加载有问题"的根因）。
                         底下一层实心 Ellipse 是占位，头像缺失/加载中时显示灰圈而不是空洞。 -->
                    <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Top" Margin="0,2,0,0">
                        <Ellipse Fill="#2A2A32" />
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding ReplyPostComment.SendUserHeadUrl, Converter={StaticResource ImageCacheConverter}, ConverterParameter=72}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="{Binding ReplyPostComment.SendUserName}" FontSize="14" FontWeight="SemiBold" Foreground="#00A3FF" />
                        <RichTextBlock helpers:InlineRunsHelper.RunsSource="{Binding ReplyPostComment.ContentRuns}"
                                       FontSize="13" Foreground="White" Margin="0,2,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ReplyPostComment.ShowTime}" FontSize="11" Foreground="#7A7A85" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 回复列表 -->
            <ListView Grid.Row="1" ItemsSource="{Binding ReplyItems}"
                      IsItemClickEnabled="True" ItemClick="OnReplyClick"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Top" Margin="0,2,0,0">
                                <Ellipse Fill="#2A2A32" />
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding UserHeadUrl, Converter={StaticResource ImageCacheConverter}, ConverterParameter=72}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding UserName}" FontSize="13" FontWeight="SemiBold" Foreground="#00A3FF" />
                                    <TextBlock Text=" 回复 " FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" />
                                    <TextBlock Text="{Binding ToUserName}" FontSize="12" Foreground="#8E8E93" />
                                    <Border Background="#2A6F2A" Padding="4,1" Margin="6,0,0,0"
                                            Visibility="{Binding IsPublisher, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="楼主" FontSize="10" Foreground="White" />
                                    </Border>
                                </StackPanel>
                                <RichTextBlock helpers:InlineRunsHelper.RunsSource="{Binding ContentRuns}"
                                               FontSize="13" Foreground="White" Margin="0,2,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ReplyTime}" FontSize="11" Foreground="#7A7A85" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
