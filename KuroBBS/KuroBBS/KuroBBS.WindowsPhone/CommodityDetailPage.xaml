<Page
    x:Class="KuroBBS.CommodityDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:KuroBBS.Helpers"
    xmlns:models="using:KuroBBS.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <ProgressBar VerticalAlignment="Top" IsIndeterminate="{Binding IsBusy}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                     Foreground="{StaticResource MetroAccentBrush}" Canvas.ZIndex="99" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,0,16,24">

                <StackPanel Margin="0,14,0,12">
                    <TextBlock Text="KURO · 商品详情" FontSize="11" Foreground="{StaticResource MetroAccentBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Light" Foreground="White"
                               TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>

                <!-- 商品图 -->
                <Border Background="#141418" BorderBrush="#2C2C34" BorderThickness="1" Margin="0,0,0,12">
                    <Image helpers:KuroLazyImage.SourceUrl="{Binding PictureUrl}"
                           helpers:KuroLazyImage.DecodeWidth="480"
                           Stretch="Uniform" MaxHeight="220" />
                </Border>

                <!-- 价格 / 归属 / 限购 -->
                <Border Background="{StaticResource MetroCardBackgroundBrush}" BorderBrush="#2C2C34"
                        BorderThickness="1" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="兑换价格" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" />
                            <TextBlock Text="{Binding PriceText}" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource MetroGoldBrush}" />
                            <TextBlock Text="{Binding GameName}" FontSize="11"
                                       Foreground="{StaticResource MetroSubTextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#20202C" Padding="8,4" VerticalAlignment="Top"
                                Visibility="{Binding HasLimit, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding LimitText}" FontSize="11" Foreground="#FFA500" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 商品描述（按行拆开展示） -->
                <Border Background="{StaticResource MetroCardBackgroundBrush}" BorderBrush="#2C2C34"
                        BorderThickness="1" Padding="14" Margin="0,0,0,12"
                        Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="商品说明" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding DescLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="#D0D0DC"
                                               TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 选择接收奖励的游戏角色 -->
                <Border Background="{StaticResource MetroCardBackgroundBrush}" BorderBrush="#2C2C34"
                        BorderThickness="1" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="接收奖励的角色" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" FontSize="12" Foreground="White" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- 数量 -->
                <Border Background="{StaticResource MetroCardBackgroundBrush}" BorderBrush="#2C2C34"
                        BorderThickness="1" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="兑换数量" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="{Binding TotalPriceText}" FontSize="12"
                                       Foreground="{StaticResource MetroGoldBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="-" Click="OnDecreaseClick" Width="44" Padding="0" />
                            <TextBlock Text="{Binding BuyNum}" FontSize="16" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center" Margin="12,0" />
                            <Button Content="+" Click="OnIncreaseClick" Width="44" Padding="0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 购买按钮 -->
                <Button Content="立即兑换" Command="{Binding BuyCommand}" HorizontalAlignment="Stretch"
                        Background="{StaticResource MetroAccentBrush}" Foreground="White"
                        FontWeight="Bold" Padding="0,14" Margin="0,0,0,12"
                        IsEnabled="{Binding CanBuy}"
                        Visibility="{Binding HasOrder, Converter={StaticResource InvBoolToVis}}" />

                <!-- 下单结果 -->
                <Border Background="{StaticResource MetroCardBackgroundBrush}"
                        BorderBrush="{StaticResource MetroAccentBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,12"
                        Visibility="{Binding HasOrder, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Order.StatusText}" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource MetroAccentBrush}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="64" Height="64" Background="#101016" Margin="0,0,12,0">
                                <Image Source="{Binding Order.PictureUrl, Converter={StaticResource ImageCache}, ConverterParameter=120}"
                                       Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Order.CommodityName}" FontSize="14" Foreground="White" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Order.CostText}" FontSize="12"
                                           Foreground="{StaticResource MetroGoldBrush}" Margin="0,2,0,0" />
                                <TextBlock FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,2,0,0">
                                    <Run Text="订单号 " />
                                    <Run Text="{Binding Order.OrderCode}" />
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,2,0,0">
                                    <Run Text="发放角色 " />
                                    <Run Text="{Binding Order.RoleName}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 状态 / 错误提示（金币不足、已达限购等服务端原因） -->
                <Border Background="#CC1A1A22" Padding="12,8"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="White" TextWrapping="Wrap" />
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
