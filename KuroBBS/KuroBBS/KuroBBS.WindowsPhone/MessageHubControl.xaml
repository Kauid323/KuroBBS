<UserControl
    x:Class="KuroBBS.MessageHubControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KuroBBS"
    xmlns:helpers="using:KuroBBS.Helpers"
    xmlns:models="using:KuroBBS.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <ProgressBar VerticalAlignment="Top" IsIndeterminate="{Binding IsBusy}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                     Foreground="{StaticResource MetroAccentBrush}" Canvas.ZIndex="999" />

        <Pivot x:Name="HubPivot" SelectionChanged="OnHubPivotSelectionChanged">
            <Pivot.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="20" FontWeight="SemiBold" Margin="0,0,14,0" />
                </DataTemplate>
            </Pivot.HeaderTemplate>

            <!-- Tab 1: 通知 -->
            <PivotItem Header="通知" Margin="0">
                <ListView x:Name="SendersListView" ItemsSource="{Binding NoticeSenders}"
                          IsItemClickEnabled="True" ItemClick="OnSenderClick"
                          SelectionMode="None" Margin="12,8,12,0">
                    <!-- 必须 Stretch：WinRT 的 ListViewItem 默认 HorizontalContentAlignment=Left，
                         不拉伸的话行内容只有自身宽度，第 2/3 列会被压到文字后面，
                         「未读数」红点就贴不到最右边。全 app 其它列表都设了这条。 -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center" Stretch="UniformToFill"
                                       helpers:KuroLazyImage.SourceUrl="{Binding Icon}" helpers:KuroLazyImage.DecodeWidth="80" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding SenderName}" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="Red" CornerRadius="9" MinWidth="18" Height="18"
                                        Visibility="{Binding HasPoint, Converter={StaticResource BoolToVis}}"
                                        Margin="6,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PointNum}" FontSize="11" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <!-- Tab 2: 评论和回复 -->
            <PivotItem Header="评论和回复" Margin="0">
                <ListView ItemsSource="{Binding CommentNotices}"
                          IsItemClickEnabled="True" ItemClick="OnCommentClick"
                          SelectionMode="None" Margin="12,8,12,0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Width="40" Height="40" VerticalAlignment="Top" Margin="0,2,0,0" Stretch="UniformToFill"
                                       helpers:KuroLazyImage.SourceUrl="{Binding SendUserHeadUrl}" helpers:KuroLazyImage.DecodeWidth="80" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding SendUserName}" FontSize="14" FontWeight="SemiBold" Foreground="#00A3FF" />
                                    <TextBlock Text="{Binding NoticeTitle}" FontSize="13" Foreground="White" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding NoticeContent}" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ShowTime}" FontSize="11" Foreground="#7A7A85" Margin="0,2,0,0" />
                                    <Button Content="查看回复" FontSize="11" Padding="10,2" Margin="0,4,0,0"
                                            Visibility="{Binding IsReplyToMe, Converter={StaticResource BoolToVis}}"
                                            Click="OnViewReplyClick" Tag="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <!-- Tab 3: 点赞 -->
            <PivotItem Header="点赞" Margin="0">
                <ListView ItemsSource="{Binding LikeNotices}"
                          IsItemClickEnabled="True" ItemClick="OnLikeClick"
                          SelectionMode="None" Margin="12,8,12,0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Width="40" Height="40" VerticalAlignment="Top" Margin="0,2,0,0" Stretch="UniformToFill"
                                       helpers:KuroLazyImage.SourceUrl="{Binding SendUserHeadUrl}" helpers:KuroLazyImage.DecodeWidth="80" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding SendUserName}" FontSize="14" FontWeight="SemiBold" Foreground="#00A3FF" />
                                    <TextBlock Text="{Binding NoticeTitle}" FontSize="13" Foreground="White" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding NoticeContent}" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ShowTime}" FontSize="11" Foreground="#7A7A85" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <!-- Tab 4: @我的（占位：无对应接口） -->
            <PivotItem Header="@我的" Margin="0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <TextBlock Text="暂无 @我的 消息" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="该分类在已抓包的接口与 147 条 API 文档中均不存在，暂未实现。" FontSize="12"
                               Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </PivotItem>

            <!-- Tab 5: 新增粉丝 -->
            <PivotItem Header="新增粉丝" Margin="0">
                <ListView ItemsSource="{Binding Fans}"
                          IsItemClickEnabled="True" ItemClick="OnFanClick"
                          SelectionMode="None" Margin="12,8,12,0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center" Stretch="UniformToFill"
                                       helpers:KuroLazyImage.SourceUrl="{Binding UserUrl}" helpers:KuroLazyImage.DecodeWidth="80" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding UserName}" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="{Binding Signature}" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11" Foreground="#7A7A85" Margin="0,2,0,0">
                                        <Run Text="{Binding FansCount}" /><Run Text=" 粉丝 · " /><Run Text="{Binding PostCount}" /><Run Text=" 帖子" />
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="2" Content="{Binding FollowButtonText}" FontSize="12" Padding="12,2" Margin="8,0,0,0"
                                        Background="{Binding IsFollowBool, Converter={StaticResource FollowStateToBgConverter}}"
                                        Foreground="{Binding IsFollowBool, Converter={StaticResource FollowStateToFgConverter}}"
                                        BorderThickness="0" VerticalAlignment="Center"
                                        Visibility="{Binding CanFollowBack, Converter={StaticResource BoolToVis}}"
                                        Click="OnFollowBackClick" Tag="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
        </Pivot>
    </Grid>
</UserControl>
