<Page
    x:Name="WikiPnsRoot"
    x:Class="KuroBBS.GameWikiPnsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:KuroBBS.Helpers"
    xmlns:models="using:KuroBBS.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- 活动 / 战区通用卡片（热门活动、纷争战区共用）：主图 + 标题 + 剩余时间 + 进度条 -->
        <DataTemplate x:Key="EventCardTemplate">
            <Border Background="#1E1E26" BorderBrush="#2C2C36" BorderThickness="1"
                    Margin="0,0,0,8" Tapped="OnEventCardTapped" Tag="{Binding}">
                <StackPanel>
                    <Grid Height="132">
                        <Image helpers:KuroLazyImage.SourceUrl="{Binding ImageUrl}"
                               helpers:KuroLazyImage.DecodeWidth="420"
                               Stretch="UniformToFill" />
                        <Border VerticalAlignment="Bottom" Background="#B0000000" Padding="10,6">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                    <StackPanel Margin="10,6" Visibility="{Binding HasCountdown, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <TextBlock Text="{Binding Countdown.LabelText}" FontSize="11" FontWeight="SemiBold" Foreground="#FF6B7A" />
                            <TextBlock Text="{Binding Countdown.RemainingText}" FontSize="11"
                                       Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Maximum="100" Value="{Binding Countdown.ProgressPercent}"
                                     Visibility="{Binding Countdown.ShowProgress, Converter={StaticResource BoolToVis}}"
                                     Height="4" Margin="0,4,0,0" Foreground="#FF334B" Background="#33333D" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Page.BottomAppBar>
        <CommandBar Background="#121216" ClosedDisplayMode="Minimal" IsOpen="False">
            <AppBarButton Icon="Back" Label="返回" Click="OnBackClick" />
            <AppBarButton Icon="Find" Label="搜索" Click="OnSearchToggleClick" />
            <AppBarButton Icon="List" Label="全部目录" Click="OnTreeClick" />
            <AppBarButton Icon="Refresh" Label="刷新" Click="OnRefreshClick" />
        </CommandBar>
    </Page.BottomAppBar>

    <Grid>
        <!-- Native Progress Indicator -->
        <ProgressBar VerticalAlignment="Top" IsIndeterminate="{Binding IsBusy}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                     Foreground="#FF334B" Canvas.ZIndex="99" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,0,16,24">
                
                <!-- Metro Page Title Area -->
                <StackPanel Margin="0,14,0,12">
                    <TextBlock Text="KURO WIKI · 战双帕弥什" FontSize="11" Foreground="#FF4D64" FontWeight="SemiBold" />
                    <TextBlock Text="战双 游戏百科" FontSize="30" FontWeight="Light" Foreground="White" Margin="0,2,0,0" />
                </StackPanel>

                <!-- In-page Search Bar -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchInputBox" PlaceholderText="搜索战双机体、意识、武器、攻略..."
                             Text="{Binding SearchQuery, Mode=TwoWay}"
                             KeyDown="OnSearchKeyDown"
                             IsTabStop="False"
                             Background="#1B1B22" BorderBrush="#2C2C36" Foreground="White" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="搜索" Click="OnSearchClick"
                            Background="#D32F2F" Foreground="White"
                            BorderThickness="0" Padding="16,6" MinWidth="60" />
                </Grid>

                <!-- Search Results Overlay if Searching -->
                <StackPanel Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="搜索结果" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                        <Button Content="关闭搜索" HorizontalAlignment="Right" Click="OnCloseSearchClick"
                                Background="Transparent" Foreground="{StaticResource MetroSubTextBrush}"
                                BorderThickness="0" Padding="8,2" FontSize="12" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8" Background="#1E1E26" Tapped="OnSearchResultTapped" Tag="{Binding}">
                                    <Border BorderBrush="#2C2C36" BorderThickness="1" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="48" Height="48" Background="#141418" Margin="0,0,10,0">
                                                <Image Source="{Binding CoverImgUrl, Converter={StaticResource ImageCache}}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CleanTitle}" FontSize="15" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Catalogue}" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Main Content (when not actively searching) -->
                <StackPanel Visibility="{Binding IsSearching, Converter={StaticResource InvBoolToVis}}">
                    
                    <!-- Banners FlipView / Carousel -->
                    <Grid Height="140" Margin="0,0,0,16" Background="#1A1A22">
                        <FlipView ItemsSource="{Binding Banners}" x:Name="BannerFlip">
                            <FlipView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Tapped="OnBannerTapped" Tag="{Binding}">
                                        <Image Source="{Binding Url, Converter={StaticResource ImageCache}}" Stretch="UniformToFill" />
                                        <Border VerticalAlignment="Bottom" Background="#B0000000" Padding="12,6">
                                            <TextBlock Text="{Binding Title}" FontSize="13" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </FlipView.ItemTemplate>
                        </FlipView>
                    </Grid>

                    <!-- Fast Navigation (快捷导航) Grid (10 Tiles) -->
                    <TextBlock Text="快捷导航" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                    <GridView ItemsSource="{Binding Shortcuts}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnShortcutItemClick" Margin="0,0,0,16">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="5" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="60" Height="74" Margin="2,4" Background="#1A1A22">
                                    <Border BorderBrush="#2C2C36" BorderThickness="1" Padding="4">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border Width="34" Height="34" Background="#141418" HorizontalAlignment="Center">
                                                <Grid>
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MetroSubTextBrush}" />
                                                    <Image Source="{Binding IconUrl, Converter={StaticResource ImageCache}}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="10" Foreground="White" TextAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- Announcements (公告) -->
                    <StackPanel Visibility="{Binding Announcements.Count, Converter={StaticResource NullToVis}}" Margin="0,0,0,16">
                        <TextBlock Text="WIKI 公告" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Announcements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6" Background="#1E1E26" Tapped="OnAnnouncementTapped" Tag="{Binding}">
                                        <Border BorderBrush="#2C2C36" BorderThickness="1" Padding="10,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#FF4D64" TextTrimming="CharacterEllipsis" />
                                                <!-- 顶部 linkCard（仅当接口 linkCardVisible 为 true 时由数据决定是否有内容） -->
                                                <StackPanel Visibility="{Binding LinkCardVisible, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="36" Height="36" Background="#141418" Margin="0,0,8,0">
                                                            <Image Source="{Binding ImgUrl, Converter={StaticResource ImageCache}}" Stretch="UniformToFill" />
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Content}" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                                <!-- 公告正文（接口 announcement[].content） -->
                                                <TextBlock Text="{Binding Body}" Visibility="{Binding HasBody, Converter={StaticResource BoolToVis}}" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Main Modules (机体图鉴, 意识手册, 版本攻略, 怪物图鉴) -->
                    <TextBlock Text="核心模块" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                    <GridView ItemsSource="{Binding MainModules}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnShortcutItemClick" Margin="0,0,0,16">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="104" Height="70" Margin="3" Background="#1F1F28">
                                    <Border BorderBrush="#2F2F3B" BorderThickness="1" Padding="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" Background="#141418" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Image Source="{Binding IconUrl, Converter={StaticResource ImageCache}}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- 纷争战区（mainModules 里 type=hot-content-main，带剩余时间 + 进度条） -->
                    <StackPanel Visibility="{Binding ZoneCards.Count, Converter={StaticResource NullToVis}}" Margin="0,0,0,16">
                        <TextBlock Text="纷争战区" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding ZoneCards}" ItemTemplate="{StaticResource EventCardTemplate}" />
                    </StackPanel>

                    <!-- 热门资讯（mainModules 里 type=multilist：分组 + 词条） -->
                    <StackPanel Visibility="{Binding NewsGroups.Count, Converter={StaticResource NullToVis}}" Margin="0,0,0,16">
                        <TextBlock Text="热门资讯" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding NewsGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#FF6B7A" Margin="0,0,0,6" />
                                        <GridView ItemsSource="{Binding Items}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnShortcutItemClick">
                                            <GridView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" />
                                                </ItemsPanelTemplate>
                                            </GridView.ItemsPanel>
                                            <GridView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#242430" BorderBrush="#353545" BorderThickness="1" Padding="10,6" Margin="0,0,6,6">
                                                        <TextBlock Text="{Binding Title}" FontSize="12" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 特色玩法与研发（events-side：研发卡池 / 常驻玩法，带剩余时间 + 进度条） -->
                    <StackPanel Visibility="{Binding FeaturedCards.Count, Converter={StaticResource NullToVis}}" Margin="0,0,0,16">
                        <TextBlock Text="特色玩法与研发" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{Binding FeaturedCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="250" Margin="0,0,10,0" Background="#1E1E26"
                                              Tapped="OnEventCardTapped" Tag="{Binding}">
                                            <Border BorderBrush="#2C2C36" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid Height="118">
                                                        <Image helpers:KuroLazyImage.SourceUrl="{Binding ImageUrl}"
                                                               helpers:KuroLazyImage.DecodeWidth="360"
                                                               Stretch="UniformToFill" />
                                                        <Border VerticalAlignment="Bottom" Background="#B0000000" Padding="8,4">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="White" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#C8C8D0"
                                                                           Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                    <StackPanel Margin="8,6" Visibility="{Binding HasCountdown, Converter={StaticResource BoolToVis}}">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Countdown.LabelText}" FontSize="11" FontWeight="SemiBold" Foreground="#FF6B7A" />
                                                            <TextBlock Text="{Binding Countdown.RemainingText}" FontSize="11"
                                                                       Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Right" />
                                                        </Grid>
                                                        <ProgressBar Maximum="100" Value="{Binding Countdown.ProgressPercent}"
                                                                     Visibility="{Binding Countdown.ShowProgress, Converter={StaticResource BoolToVis}}"
                                                                     Height="4" Margin="0,4,0,0" Foreground="#FF334B" Background="#33333D" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- 热门活动（hot-content-side，带剩余时间 + 进度条） -->
                    <StackPanel Visibility="{Binding HotActivities.Count, Converter={StaticResource NullToVis}}" Margin="0,0,0,16">
                        <TextBlock Text="热门活动" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding HotActivities}" ItemTemplate="{StaticResource EventCardTemplate}" />
                    </StackPanel>

                    <!-- 热门话题（quick-entry） -->
                    <StackPanel Visibility="{Binding HotTopics.Count, Converter={StaticResource NullToVis}}" Margin="0,0,0,16">
                        <TextBlock Text="热门话题" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                        <GridView ItemsSource="{Binding HotTopics}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnShortcutItemClick">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#242430" BorderBrush="#353545" BorderThickness="1" Padding="12,7" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding Title}" FontSize="12" Foreground="White" />
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>

                    <!-- 其他入口（未归类的 sideModules 兜底） -->
                    <StackPanel Visibility="{Binding OtherModules.Count, Converter={StaticResource NullToVis}}" Margin="0,0,0,16">
                        <GridView ItemsSource="{Binding OtherModules}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnShortcutItemClick">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="158" Height="64" Margin="3" Background="#282226">
                                        <Border BorderBrush="#42333A" BorderThickness="1" Padding="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" Background="#141418" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <Image Source="{Binding IconUrl, Converter={StaticResource ImageCache}}" Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>

                    <!-- 指挥官贡献榜入口（点击进入 周榜 / 月榜 / 总榜） -->
                    <StackPanel Margin="0,0,0,16">
                        <Border Background="#1A1A22" BorderBrush="#2C2C36" BorderThickness="1"
                                Padding="12,10" Tapped="OnContributorHeaderTapped">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" Background="#141418" Margin="0,0,10,0" VerticalAlignment="Center"
                                        Visibility="{Binding ContributorIconUrl, Converter={StaticResource StringNotEmptyToVis}}">
                                    <Image Source="{Binding ContributorIconUrl, Converter={StaticResource ImageCache}, ConverterParameter=72}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ContributorTitle}" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="周榜 / 月榜 / 总榜" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="查看完整榜单 ›" FontSize="12" Foreground="#FF6B7A" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 榜单一瞥：TOP 10（默认周榜） -->
                        <ItemsControl ItemsSource="{Binding Contributors}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,4" Background="#1A1A22" Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding RankDisplay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MetroGoldBrush}" VerticalAlignment="Center" Width="48" />
                                            <Border Grid.Column="1" Width="30" Height="30" Background="#141418" Margin="0,0,8,0">
                                                <Image Source="{Binding UserHeadUrl, Converter={StaticResource ImageCache}, ConverterParameter=72}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding UserName}" FontSize="13" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding Score}" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
