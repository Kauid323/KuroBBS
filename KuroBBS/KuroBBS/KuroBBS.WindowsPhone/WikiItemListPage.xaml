<Page
    x:Name="WikiItemListRoot"
    x:Class="KuroBBS.WikiItemListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:KuroBBS.Helpers"
    xmlns:models="using:KuroBBS.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.BottomAppBar>
        <CommandBar Background="#121216" ClosedDisplayMode="Minimal" IsOpen="False">
            <AppBarButton Icon="Back" Label="返回" Click="OnBackClick" />
            <AppBarButton Icon="Clear" Label="重置筛选" Click="OnResetFilterClick" />
            <AppBarButton Icon="Refresh" Label="刷新" Click="OnRefreshClick" />
        </CommandBar>
    </Page.BottomAppBar>

    <Grid>
        <!-- Native Progress Indicator -->
        <ProgressBar VerticalAlignment="Top" IsIndeterminate="{Binding IsBusy}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                     Foreground="{StaticResource MetroAccentBrush}" Canvas.ZIndex="99" />

        <!-- Virtualized Metro GridView -->
        <GridView ItemsSource="{Binding FilteredItems}"
                  IsItemClickEnabled="True"
                  ItemClick="OnItemClick"
                  SelectionMode="None"
                  Padding="12,0,12,24">
            <GridView.Header>
                <StackPanel Margin="4,0,4,12">
                    <!-- Metro Page Title Area -->
                    <StackPanel Margin="0,14,0,10">
                        <Grid>
                            <TextBlock Text="WIKI 图鉴与条目" FontSize="11" Foreground="{StaticResource MetroAccentBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding FilteredItems.Count, Converter={StaticResource StringFormatConverter}, ConverterParameter='共 {0} 项'}"
                                       FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding CatalogueTitle}" FontSize="28" FontWeight="Light" Foreground="White" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Keyword Filter Search -->
                    <Grid Margin="0,0,0,10">
                        <TextBox PlaceholderText="在当前分类中搜索..."
                                 Text="{Binding Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#1B1B22" BorderBrush="#2C2C36" Foreground="White" />
                    </Grid>

                    <!-- Tag Categories / Filtering Chips -->
                    <ItemsControl ItemsSource="{Binding TagGroups}" Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,0,0,4" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Tags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Name}" Margin="0,0,6,0" Tapped="OnTagTapped" Tag="{Binding}"
                                                            Background="{Binding IsSelected, Converter={StaticResource BoolToTagBgBrush}}"
                                                            BorderBrush="{Binding IsSelected, Converter={StaticResource BoolToTagBorderBrush}}"
                                                            Foreground="White" BorderThickness="1" Padding="10,4" FontSize="11" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State -->
                    <TextBlock Text="暂无符合条件的条目"
                               Visibility="{Binding FilteredItems.Count, Converter={StaticResource InvNullToVis}}"
                               FontSize="13" Foreground="{StaticResource MetroSubTextBrush}"
                               HorizontalAlignment="Center" Margin="0,30,0,10" />
                </StackPanel>
            </GridView.Header>

            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="116" ItemHeight="152" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>

            <GridView.ItemTemplate>
                <DataTemplate>
                    <Grid Width="110" Height="146" Margin="2" Background="#1E1E26">
                        <Border BorderBrush="#2C2C36" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="100" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Item Thumbnail / Icon with compact 150px decode to prevent OOM -->
                                <Border Background="#141418">
                                    <Image Source="{Binding IconUrl, Converter={StaticResource ImageCache}, ConverterParameter=150}" Stretch="UniformToFill" />
                                </Border>

                                <!-- Level / Rarity Tag -->
                                <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                        Background="{Binding Level, Converter={StaticResource LevelToBrush}}"
                                        Padding="5,1" Margin="0,4,4,0"
                                        Visibility="{Binding Level, Converter={StaticResource NullToVis}}">
                                    <TextBlock Text="{Binding Level}" FontSize="10" FontWeight="Bold" Foreground="Black" />
                                </Border>

                                <!-- Item Title & Subtitle -->
                                <Border Grid.Row="1" Background="#181820" Padding="4,2">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                                        <TextBlock Text="{Binding SubTitle}" FontSize="9" Foreground="{StaticResource MetroSubTextBrush}" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                                   Visibility="{Binding SubTitle, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
