<Page
    x:Class="KuroBBS.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KuroBBS"
    xmlns:helpers="using:KuroBBS.Helpers"
    xmlns:models="using:KuroBBS.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.BottomAppBar>
        <CommandBar x:Name="MainCommandBar" Background="#121216" ClosedDisplayMode="Compact" IsOpen="False">
            <AppBarButton Icon="Edit" Label="发帖" Click="OnCreatePostClick" />
            <AppBarButton Icon="Find" Label="搜索" Click="OnSearchClick" />
            <AppBarButton x:Name="GameFilterAppBarButton" Icon="Filter" Label="分区切换">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="鸣潮 (Wuthering Waves)" Click="OnSelectMingChaoClick" />
                        <MenuFlyoutItem Text="战双帕弥什 (Punishing Gray Raven)" Click="OnSelectZhanShuangClick" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Icon="Refresh" Label="刷新" Command="{Binding RefreshCommand}" />
            
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="鸣潮 (Wuthering Waves)" Click="OnSelectMingChaoClick" />
                <AppBarButton Label="战双帕弥什 (Punishing Gray Raven)" Click="OnSelectZhanShuangClick" />
                <AppBarButton Label="默认推荐" Command="{Binding SelectSortCommand}" CommandParameter="3" />
                <AppBarButton Label="最新回复" Command="{Binding SelectSortCommand}" CommandParameter="2" />
                <AppBarButton Label="最新发布" Command="{Binding SelectSortCommand}" CommandParameter="1" />
                <AppBarButton Label="每日签到" Click="OnGoToSignInClick" />
                <AppBarButton Label="系统设置" Click="OnSettingsClick" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>

    <Grid>
        <!-- Native Metro Progress Indicator when Loading -->
        <ProgressBar VerticalAlignment="Top" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource MetroAccentBrush}" Canvas.ZIndex="999" />

        <!-- Pure Native Windows Phone 8.1 Metro Pivot -->
        <Pivot x:Name="MainPivot" Title="{Binding SelectedGameName}">
            <Pivot.TitleTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,0,0,0" />
                </DataTemplate>
            </Pivot.TitleTemplate>
            <Pivot.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="20" FontWeight="SemiBold" Margin="0,0,14,0" />
                </DataTemplate>
            </Pivot.HeaderTemplate>
            
            <!-- Tab 1: 社区动态 (Sub-forums & Sortable Feed) -->
            <PivotItem Header="动态" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Pure Metro Minimalist Single-Row Sub-forum Strip + Right-aligned Cycle Sort Button -->
                    <Grid x:Name="CommunityTabHeaderGrid" Grid.Row="0" Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 5 Sub-forums on the left -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 推荐 -->
                            <Border Background="Transparent" Padding="4,4,12,6" Tag="0" Tapped="OnSubForumTapped">
                                <TextBlock Text="{Binding SubForumName0}" FontSize="14" FontWeight="{Binding IsSubForum0, Converter={StaticResource BoolToFontWeight}}" Foreground="{Binding IsSubForum0, Converter={StaticResource BoolToActiveBrush}}" />
                            </Border>

                            <!-- 综合 / 伊甸闲庭 -->
                            <Border Background="Transparent" Padding="4,4,12,6" Tag="1" Tapped="OnSubForumTapped">
                                <TextBlock Text="{Binding SubForumName1}" FontSize="14" FontWeight="{Binding IsSubForum1, Converter={StaticResource BoolToFontWeight}}" Foreground="{Binding IsSubForum1, Converter={StaticResource BoolToActiveBrush}}" />
                            </Border>

                            <!-- 攻略 -->
                            <Border Background="Transparent" Padding="4,4,12,6" Tag="2" Tapped="OnSubForumTapped">
                                <TextBlock Text="{Binding SubForumName2}" FontSize="14" FontWeight="{Binding IsSubForum2, Converter={StaticResource BoolToFontWeight}}" Foreground="{Binding IsSubForum2, Converter={StaticResource BoolToActiveBrush}}" />
                            </Border>

                            <!-- 同人图 / 同人 -->
                            <Border Background="Transparent" Padding="4,4,12,6" Tag="3" Tapped="OnSubForumTapped">
                                <TextBlock Text="{Binding SubForumName3}" FontSize="14" FontWeight="{Binding IsSubForum3, Converter={StaticResource BoolToFontWeight}}" Foreground="{Binding IsSubForum3, Converter={StaticResource BoolToActiveBrush}}" />
                            </Border>

                            <!-- 同人文 / Cosplay -->
                            <Border Background="Transparent" Padding="4,4,12,6" Tag="4" Tapped="OnSubForumTapped">
                                <TextBlock Text="{Binding SubForumName4}" FontSize="14" FontWeight="{Binding IsSubForum4, Converter={StaticResource BoolToFontWeight}}" Foreground="{Binding IsSubForum4, Converter={StaticResource BoolToActiveBrush}}" />
                            </Border>
                        </StackPanel>

                        <!-- Right-aligned Single Cycle Sort Button (only for 伊甸闲庭) -->
                        <Border Grid.Column="1" Visibility="{Binding IsEdenForum, Converter={StaticResource BoolToVis}}" Background="Transparent" Padding="8,4,4,6" VerticalAlignment="Center" Tapped="OnCycleSortTapped">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedSearchTypeName}" FontSize="12" Foreground="{StaticResource MetroAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text=" ⟳" FontSize="12" Foreground="{StaticResource MetroAccentBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Community Post List with Fluid Metro Transitions -->
                    <ListView Grid.Row="1" ItemsSource="{Binding CommunityPosts}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnPostItemClick" Loaded="OnCommunityListLoaded">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="40" FromHorizontalOffset="0" />
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource MetroCardBackgroundBrush}" Padding="14" BorderBrush="#2C2C34" BorderThickness="1">
                                    <StackPanel>
                                        <!-- Author Row -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- User Avatar with Disk & Memory Cache (Tap for Profile) -->
                                            <Border Grid.Column="0" Width="36" Height="36" Margin="0,0,10,0" Background="#282832" Tapped="OnAuthorTapped" Tag="{Binding Author}">
                                                <Grid>
                                                    <TextBlock Text="K" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#8E8E93" />
                                                    <Ellipse Width="36" Height="36">
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding Author.AvatarUrl, Converter={StaticResource ImageCacheConverter}, ConverterParameter=96}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Tapped="OnAuthorTapped" Tag="{Binding Author}">
                                                <TextBlock Text="{Binding Author.UserName}" FontWeight="SemiBold" FontSize="14" Foreground="White" />
                                                <TextBlock Text="{Binding PostTimeStr}" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" />
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="#282832" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GameName}" FontSize="10" Foreground="{StaticResource MetroAccentBrush}" />
                                            </Border>
                                        </Grid>

                                        <!-- Post Title -->
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,4" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />

                                        <!-- Post Content Summary -->
                                        <TextBlock Text="{Binding ContentSummary}" FontSize="13" Foreground="#C8C8CE" Margin="0,0,0,8" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" LineHeight="18" />

                                        <!-- Cached Cover Image with Dynamic Metro Skeleton Layer -->
                                        <Border Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" MaxHeight="180" Margin="0,0,0,8" Background="#16161E">
                                            <Grid>
                                                <Border Background="#22222C" Height="140">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20">
                                                        <ProgressBar IsIndeterminate="True" Width="130" Foreground="{StaticResource MetroAccentBrush}" Opacity="0.75" Margin="0,0,0,8" />
                                                        <TextBlock Text="正在载入图片..." FontSize="10" Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Center" Opacity="0.6" />
                                                    </StackPanel>
                                                </Border>
                                                <Image Source="{Binding CoverUrl, Converter={StaticResource ImageCacheConverter}, ConverterParameter=640}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>

                                        <!-- Action Stats Bar -->
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Author.IpRegion}" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="♥ " Foreground="{StaticResource MetroAccentBrush}" FontSize="12" />
                                                <TextBlock Text="{Binding LikeCount}" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="💬 " Foreground="{StaticResource MetroAccentBrush}" FontSize="12" />
                                                <TextBlock Text="{Binding CommentCount}" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                        <!-- Smooth Automatic Loading Footer -->
                        <ListView.Footer>
                            <Grid Margin="0,12,0,24" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <ProgressRing IsActive="True" Width="20" Height="20" Foreground="{StaticResource MetroAccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="正在加载动态..." FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </ListView.Footer>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- Tab 2: 官方 (Official Events: 活动 / 公告 / 资讯) -->
            <PivotItem Header="官方" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Minimalist Metro Sub-tab Strip (活动, 公告, 资讯) -->
                    <Grid x:Name="OfficialTabHeaderGrid" Grid.Row="0" Margin="0,2,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 活动 (eventType=1) -->
                            <Border Background="Transparent" Padding="4,4,14,6" Tag="1" Tapped="OnOfficialEventTapped">
                                <TextBlock Text="活动" FontSize="14" FontWeight="{Binding IsOfficialEvent1, Converter={StaticResource BoolToFontWeight}}" Foreground="{Binding IsOfficialEvent1, Converter={StaticResource BoolToActiveBrush}}" />
                            </Border>

                            <!-- 公告 (eventType=3) -->
                            <Border Background="Transparent" Padding="4,4,14,6" Tag="3" Tapped="OnOfficialEventTapped">
                                <TextBlock Text="公告" FontSize="14" FontWeight="{Binding IsOfficialEvent3, Converter={StaticResource BoolToFontWeight}}" Foreground="{Binding IsOfficialEvent3, Converter={StaticResource BoolToActiveBrush}}" />
                            </Border>

                            <!-- 资讯 (eventType=2) -->
                            <Border Background="Transparent" Padding="4,4,14,6" Tag="2" Tapped="OnOfficialEventTapped">
                                <TextBlock Text="资讯" FontSize="14" FontWeight="{Binding IsOfficialEvent2, Converter={StaticResource BoolToFontWeight}}" Foreground="{Binding IsOfficialEvent2, Converter={StaticResource BoolToActiveBrush}}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding SelectedOfficialEventTypeName, Converter={StaticResource StringFormatConverter}, ConverterParameter='官方 · {0}'}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,0,2,2" />
                    </Grid>

                    <!-- Official News List with Fluid Metro Transitions -->
                    <ListView Grid.Row="1" ItemsSource="{Binding NewsList}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnPostItemClick" Loaded="OnNewsListLoaded">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="40" FromHorizontalOffset="0" />
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,0,0,12" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource MetroCardBackgroundBrush}" Padding="14" BorderBrush="#2C2C34" BorderThickness="1">
                                    <StackPanel>
                                        <!-- Author Row -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Official Avatar with Disk & Memory Cache -->
                                            <Border Grid.Column="0" Width="36" Height="36" Margin="0,0,10,0" Background="#282832">
                                                <Grid>
                                                    <TextBlock Text="K" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#8E8E93" />
                                                    <Ellipse Width="36" Height="36">
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding Author.AvatarUrl, Converter={StaticResource ImageCacheConverter}, ConverterParameter=96}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Author.UserName}" FontWeight="SemiBold" FontSize="14" Foreground="White" />
                                                <TextBlock Text="{Binding PostTimeStr}" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" />
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="#282832" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GameName}" FontSize="10" Foreground="{StaticResource MetroAccentBrush}" />
                                            </Border>
                                        </Grid>

                                        <!-- Cached News Banner Cover with Dynamic Metro Skeleton Layer -->
                                        <Border Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" MaxHeight="160" Margin="0,0,0,8" Background="#16161E">
                                            <Grid>
                                                <Border Background="#22222C" Height="130">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20">
                                                        <ProgressBar IsIndeterminate="True" Width="130" Foreground="{StaticResource MetroAccentBrush}" Opacity="0.75" Margin="0,0,0,8" />
                                                        <TextBlock Text="正在载入横幅..." FontSize="10" Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Center" Opacity="0.6" />
                                                    </StackPanel>
                                                </Border>
                                                <Image Source="{Binding CoverUrl, Converter={StaticResource ImageCacheConverter}, ConverterParameter=640}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>

                                        <!-- Title -->
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,4" TextWrapping="Wrap" MaxLines="2" />

                                        <!-- Content Summary -->
                                        <TextBlock Text="{Binding ContentSummary}" FontSize="13" Foreground="#C8C8CE" Margin="0,0,0,4" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" LineHeight="18" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                        <!-- Smooth Automatic Loading Footer -->
                        <ListView.Footer>
                            <Grid Margin="0,12,0,24" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <ProgressRing IsActive="True" Width="20" Height="20" Foreground="{StaticResource MetroAccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="正在加载..." FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </ListView.Footer>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- Tab 3: 游戏工具与WIKI导航 (Game Wiki & Tools) -->
            <PivotItem Header="游戏" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,6,12,24">
                        <!-- Section Header -->
                        <Border Background="{StaticResource MetroCardBackgroundBrush}" Padding="14" BorderBrush="#2C2C34" BorderThickness="1" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="游戏工具与WIKI" FontSize="16" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="{Binding SelectedGameName, Converter={StaticResource StringFormatConverter}, ConverterParameter='当前分区: {0} 官方实用工具库'}" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="🎮" FontSize="26" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Game Wiki / Tools GridView (flat Metro square tiles) -->
                        <GridView ItemsSource="{Binding GameWikiList}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="OnGameWikiItemClick">
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource MetroCardBackgroundBrush}" BorderBrush="#2C2C34" BorderThickness="1"
                                            Width="96" Height="100" Margin="0,0,8,8" Padding="6">
                                        <Grid>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <!-- Icon -->
                                                <Border Width="44" Height="44" Background="#141418" BorderBrush="#333340" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <Image Source="{Binding DisplayIcon, Converter={StaticResource ImageCacheConverter}}" Stretch="UniformToFill" />
                                                </Border>

                                                <!-- Wiki / Tool Name -->
                                                <TextBlock Text="{Binding WikiName}" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                                           HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            </StackPanel>

                                            <!-- Red Point Indicator (if showRedPoint) -->
                                            <Border Visibility="{Binding ShowRedPoint, Converter={StaticResource BoolToVis}}"
                                                    Width="8" Height="8" Background="#FF3B30"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Tab 4: 每日签到 -->
            <PivotItem Header="签到" Margin="0">
                <ScrollViewer>
                    <StackPanel Margin="0,0,0,20">
                        
                        <!-- Role Selector Card -->
                        <Border Background="{StaticResource MetroCardBackgroundBrush}" Padding="14" BorderBrush="#2C2C34" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="签到角色与游戏分区" FontSize="12" Foreground="{StaticResource MetroAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="点击选择角色" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- WP8.1 Native Full-screen ComboBox Picker -->
                                <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,0,8" Background="#141418" Foreground="White" BorderBrush="#3A3A48">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2,4">
                                                <Border Background="{StaticResource MetroAccentBrush}" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GameName}" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding RoleName}" FontWeight="Bold" FontSize="15" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ServerName}" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding LevelDisplay}" FontSize="12" Foreground="{StaticResource MetroGoldBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Border Background="#141418" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding SelectedRoleDisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                            <TextBlock Text="{Binding SelectedRole.EnergyDisplay}" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="✓ 当前签到目标" FontSize="11" Foreground="{StaticResource MetroAccentBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Big Interactive Sign-in Card -->
                        <Border Background="{StaticResource MetroCardBackgroundBrush}" Padding="16" BorderBrush="{StaticResource MetroAccentBrush}" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="库街区福利中心" FontSize="12" Foreground="{StaticResource MetroAccentBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SignInInfo.GameName}" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,2,0,8" />

                                <Grid Margin="0,8,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="连续签到" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" />
                                        <TextBlock Text="{Binding SignInInfo.ConsecutiveDays}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource MetroAccentBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="累计签到" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" />
                                        <TextBlock Text="{Binding SignInInfo.TotalSignInDays}" FontSize="22" FontWeight="Bold" Foreground="White" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="补签卡" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" />
                                        <TextBlock Text="{Binding SignInInfo.ReplenishCardCount}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource MetroGoldBrush}" />
                                    </StackPanel>
                                </Grid>

                                <Button Content="立即签到领取奖励" Command="{Binding ExecuteSignInCommand}" HorizontalAlignment="Stretch" Background="{StaticResource MetroAccentBrush}" Foreground="White" FontWeight="Bold" Padding="0,12" />
                            </StackPanel>
                        </Border>

                        <!-- 库洛币余额：点击进入金币商店 -->
                        <Button Background="{StaticResource MetroCardBackgroundBrush}" Padding="16"
                                BorderBrush="{StaticResource MetroGoldBrush}" BorderThickness="1" Margin="0,0,0,10"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Click="OnGoToGoldShopClick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="库洛金币 / 库洛币余额" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" />
                                    <TextBlock Text="{Binding Profile.GoldCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource MetroGoldBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="金币商店" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Grid.Column="2" Text="&#xE0E3;" FontFamily="Segoe UI Symbol" FontSize="14"
                                           Foreground="{StaticResource MetroSubTextBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- 任务中心入口 -->
                        <Button Background="{StaticResource MetroCardBackgroundBrush}" Padding="14,12"
                                BorderBrush="#2C2C34" BorderThickness="1" Margin="0,0,0,12"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Click="OnGoToTaskCenterClick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE0B6;" FontFamily="Segoe UI Symbol" FontSize="18"
                                           Foreground="{StaticResource MetroAccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="任务中心" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="做任务赚库洛币 · 查看金币明细" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE0E3;" FontFamily="Segoe UI Symbol" FontSize="14"
                                           Foreground="{StaticResource MetroSubTextBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Month Reward Supply Calendar -->
                        <TextBlock Text="本月物资奖励日历" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,4,0,8" />
                        <ItemsControl ItemsSource="{Binding SignInInfo.MonthRecords}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="80" ItemHeight="96" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#16161E" BorderBrush="#262632" BorderThickness="1" Margin="2" Padding="4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <TextBlock Text="{Binding Date}" FontSize="10" Foreground="{StaticResource MetroSubTextBrush}" />
                                                <TextBlock Text="{Binding RewardCountDisplay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MetroGoldBrush}" HorizontalAlignment="Right" />
                                            </Grid>

                                            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2">
                                                <Image Source="{Binding RewardIcon, Converter={StaticResource ImageCacheConverter}, ConverterParameter=96}" Width="38" Height="38" Stretch="Uniform" />
                                            </Grid>

                                            <TextBlock Grid.Row="2" Text="{Binding RewardName}" FontSize="9" Foreground="White" TextTrimming="CharacterEllipsis" TextAlignment="Center" />

                                            <Border Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" Background="#B0000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.RowSpan="3" Margin="-4">
                                                <Border Background="{StaticResource MetroAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="6,2">
                                                    <TextBlock Text="已获取" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Sign-in Claim History Records -->
                        <Border Visibility="{Binding HasSignInClaimRecords, Converter={StaticResource BoolToVis}}" Margin="0,16,0,8">
                            <TextBlock Text="近期签到发放记录" FontSize="14" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding SignInClaimRecords}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource MetroCardBackgroundBrush}" BorderBrush="#262630" BorderThickness="1" Padding="10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" Background="#1E1E28" Margin="0,0,10,0">
                                                <Image Source="{Binding GoodsUrl, Converter={StaticResource ImageCacheConverter}, ConverterParameter=96}" Stretch="Uniform" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding GoodsName}" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding GoodsNumText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MetroGoldBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding SignInDate}" FontSize="10" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#203628" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="已发放" FontSize="10" Foreground="#34C759" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Official Recommend Follows -->
                        <Border Visibility="{Binding HasCommendFollows, Converter={StaticResource BoolToVis}}" Margin="0,16,0,8">
                            <TextBlock Text="官方推荐关注" FontSize="14" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding CommendFollows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource MetroCardBackgroundBrush}" BorderBrush="#262630" BorderThickness="1" Padding="10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="40" Height="40" Background="#1E1E28" Margin="0,0,10,0">
                                                <Image Source="{Binding UserHeadUrl, Converter={StaticResource ImageCacheConverter}, ConverterParameter=96}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding UserName}" FontSize="13" FontWeight="Bold" Foreground="White" />
                                                <TextBlock Text="{Binding UserSign}" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,2,0,0" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="{Binding FollowBtnText}" Tag="{Binding}" Click="OnFollowCommendClick" Background="#262634" Foreground="{StaticResource MetroAccentBrush}" FontSize="11" Padding="10,4" BorderThickness="0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Tab 4: 角色战绩 -->
            <PivotItem Header="战绩">
                <ScrollViewer>
                    <StackPanel Margin="0,0,0,20">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="已绑定的游戏角色 (点击可设为当前角色)" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        </Grid>

                        <ListView ItemsSource="{Binding Roles}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnRoleItemClick" ScrollViewer.VerticalScrollMode="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource MetroCardBackgroundBrush}" Padding="14" BorderBrush="#2C2C34" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="44" Height="44" Background="{StaticResource MetroAccentBrush}" Margin="0,0,12,0">
                                                <TextBlock Text="⚔" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding RoleName}" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,6,0" />
                                                    <Border Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}" Background="#333344" Padding="4,1" VerticalAlignment="Center">
                                                        <TextBlock Text="默认" FontSize="9" Foreground="{StaticResource MetroAccentBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ServerName}" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding GameName}" FontSize="11" Foreground="{StaticResource MetroAccentBrush}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border Background="#282834" Padding="8,4">
                                                    <TextBlock Text="{Binding LevelDisplay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource MetroGoldBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding EnergyDisplay}" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Box Shortcuts -->
                        <TextBlock Text="官方战绩工具箱" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,12,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource MetroCardBackgroundBrush}" Padding="12" Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="鸣潮声骸图鉴" FontSize="13" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="共鸣评级与属性搭配" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource MetroCardBackgroundBrush}" Padding="12" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="战双意识手册" FontSize="13" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="全构造体毕业配装" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Tab 5: 个人中心与账号登录 -->
            <PivotItem Header="我的" Margin="0">
                <ScrollViewer>
                    <StackPanel Margin="0,0,0,20">
                        
                        <!-- Logged In State: Profile Card -->
                        <Border Visibility="{Binding Profile.IsLoggedIn, Converter={StaticResource BoolToVis}}" Background="{StaticResource MetroCardBackgroundBrush}" Padding="16" BorderBrush="#2C2C34" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,12" Background="Transparent" Tapped="OnMyProfileTapped">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- User Avatar in Profile -->
                                    <Border Grid.Column="0" Width="52" Height="52" Margin="0,0,12,0" Background="#282832">
                                        <Grid>
                                            <TextBlock Text="👤" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                                            <Ellipse Width="52" Height="52">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding Profile.AvatarUrl, Converter={StaticResource ImageCacheConverter}}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Profile.UserName}" FontSize="17" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="{Binding Profile.UserId, Converter={StaticResource StringFormatConverter}, ConverterParameter='UID: {0}'}" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" />
                                        <TextBlock Text="{Binding Profile.IpRegion, Converter={StaticResource StringFormatConverter}, ConverterParameter='IP 属地: {0}'}" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="〉" FontSize="16" Foreground="{StaticResource MetroSubTextBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </Grid>

                                <TextBlock Text="{Binding Profile.Signature}" FontSize="12" Foreground="#C8C8CE" Margin="0,0,0,12" TextWrapping="Wrap" />

                                <!-- Stats Row -->
                                <Grid Margin="0,0,0,12" Background="Transparent" Tapped="OnMyProfileTapped">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="关注" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" />
                                        <TextBlock Text="{Binding Profile.FollowingCount}" FontSize="16" FontWeight="Bold" Foreground="White" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="粉丝" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" />
                                        <TextBlock Text="{Binding Profile.FansCount}" FontSize="16" FontWeight="Bold" Foreground="White" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="动态" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" />
                                        <TextBlock Text="{Binding Profile.PostCount}" FontSize="16" FontWeight="Bold" Foreground="White" />
                                    </StackPanel>
                                </Grid>

                                <Button Content="退出当前登录" Command="{Binding LogoutCommand}" HorizontalAlignment="Stretch" Background="#282834" Foreground="#FF6B6B" BorderThickness="0" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Not Logged In State: Metro Login Card -->
                        <Border Visibility="{Binding Profile.IsLoggedIn, Converter={StaticResource InvBoolToVis}}" Background="{StaticResource MetroCardBackgroundBrush}" Padding="18" BorderBrush="#2C2C34" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="👤" FontSize="36" HorizontalAlignment="Center" Margin="0,6,0,10" Foreground="{StaticResource MetroAccentBrush}" />
                                <TextBlock Text="未登录账号" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="登录后可同步游戏角色战绩、参与社区互动与每日签到" FontSize="12" Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,18" />

                                <Button Content="登录库街区账号" Click="OnLoginButtonClick" HorizontalAlignment="Stretch" Background="{StaticResource MetroAccentBrush}" Foreground="White" FontWeight="Bold" FontSize="15" Padding="0,10" BorderThickness="0" />
                            </StackPanel>
                        </Border>

                        <!-- Settings Entry Button -->
                        <Button Content="⚙ 系统设置" Click="OnSettingsClick" HorizontalAlignment="Stretch" Background="{StaticResource MetroCardBackgroundBrush}" Foreground="White" BorderBrush="#2C2C34" BorderThickness="1" Margin="0,0,0,12" HorizontalContentAlignment="Left" Padding="14,10" />

                        <!-- About Info -->
                        <Border Background="{StaticResource MetroCardBackgroundBrush}" Padding="16" BorderBrush="#2C2C34" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="关于客户端" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,0,0,4" />
                                <TextBlock Text="KuroBBS Windows Phone 8.1 Metro Edition" FontSize="12" Foreground="White" />
                                <TextBlock Text="基于官方前端 125 模块纯净逆向构建" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,2,0,0" />
                                <TextBlock Text="支持鸣潮 / 战双帕弥什 论坛动态、官方资讯、签到与战绩" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>


        <!-- Geetest GT4 Risk Verification Modal Overlay -->
        <Grid Visibility="{Binding IsGeetestVisible, Converter={StaticResource BoolToVis}}" Background="#E8000000" Canvas.ZIndex="1000">
            <Border Background="#181822" BorderBrush="{StaticResource MetroAccentBrush}" BorderThickness="1" Margin="16" VerticalAlignment="Center" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="310" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="极验安全验证" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        <Button Content="✕" Command="{Binding CloseGeetestCommand}" HorizontalAlignment="Right" Background="Transparent" Foreground="#8E8E93" FontSize="16" Padding="6,2" BorderThickness="0" />
                    </Grid>

                    <!-- Geetest WebView Container -->
                    <Border Grid.Row="1" Background="#121218" BorderBrush="#2C2C34" BorderThickness="1">
                        <WebView x:Name="GeetestWebView" ScriptNotify="OnGeetestScriptNotify" />
                    </Border>

                    <!-- Footer Tip -->
                    <TextBlock Grid.Row="2" Text="请在上方完成滑块或手势验证以发送短信验证码" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
