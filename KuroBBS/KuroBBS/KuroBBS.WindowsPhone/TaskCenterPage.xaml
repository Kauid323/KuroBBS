<Page
    x:Class="KuroBBS.TaskCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:KuroBBS.Helpers"
    xmlns:models="using:KuroBBS.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <ProgressBar VerticalAlignment="Top" IsIndeterminate="{Binding IsBusy}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                     Foreground="{StaticResource MetroAccentBrush}" Canvas.ZIndex="99" />

        <Pivot x:Name="RootPivot" Title="任务中心">
            <!-- 任务 -->
            <PivotItem Header="任务" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,0,16,24">

                        <!-- 余额 / 今日进度 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource MetroCardBackgroundBrush}"
                                    BorderBrush="{StaticResource MetroGoldBrush}" BorderThickness="1" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="我的库洛币" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" />
                                    <TextBlock Text="{Binding GoldText}" FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource MetroGoldBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource MetroCardBackgroundBrush}"
                                    BorderBrush="#2C2C34" BorderThickness="1" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="今日已获金币" FontSize="11" Foreground="{StaticResource MetroSubTextBrush}" />
                                    <TextBlock Text="{Binding DailyGoldText}" FontSize="22" FontWeight="Bold" Foreground="White" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 成长任务 -->
                        <TextBlock Text="成长任务" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,8"
                                   Visibility="{Binding HasGrowTasks, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding GrowTasks}"
                                      Visibility="{Binding HasGrowTasks, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource MetroCardBackgroundBrush}" BorderBrush="#2C2C34"
                                            BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Remark}" FontSize="13" Foreground="White" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ProgressText}" FontSize="11"
                                                           Foreground="{StaticResource MetroSubTextBrush}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding GoldText}" FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource MetroGoldBrush}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                           Foreground="{StaticResource MetroAccentBrush}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 每日任务 -->
                        <TextBlock Text="每日任务" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,8"
                                   Visibility="{Binding HasDailyTasks, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding DailyTasks}"
                                      Visibility="{Binding HasDailyTasks, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource MetroCardBackgroundBrush}" BorderBrush="#2C2C34"
                                            BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Remark}" FontSize="13" Foreground="White" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ProgressText}" FontSize="11"
                                                           Foreground="{StaticResource MetroSubTextBrush}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding GoldText}" FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource MetroGoldBrush}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                           Foreground="{StaticResource MetroAccentBrush}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 金币流水 -->
            <PivotItem Header="金币明细" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,0,16,24">
                        <ItemsControl ItemsSource="{Binding GoldLogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource MetroCardBackgroundBrush}" BorderBrush="#2C2C34"
                                            BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Remark}" FontSize="13" Foreground="White" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding TimeText}" FontSize="11"
                                                           Foreground="{StaticResource MetroSubTextBrush}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding GoldText}" FontSize="16" FontWeight="Bold"
                                                       Foreground="{StaticResource MetroGoldBrush}"
                                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="暂无金币明细" FontSize="13" Foreground="{StaticResource MetroSubTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,20,0,0"
                                   Visibility="{Binding HasLogs, Converter={StaticResource InvBoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>

        <Border VerticalAlignment="Bottom" Background="#CC1A1A22" Padding="12,8"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="White" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Page>
